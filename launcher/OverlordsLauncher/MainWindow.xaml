<Window x:Class="OverlordsLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverlordsXI Launcher"
        Width="1040"
        Height="700"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#080B12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource GoldAccent}" Margin="0,0,10,0" />
                    <TextBlock Text="OVERLORDS XI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource GoldAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="  •  CLIENT LAUNCHER" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="44" Height="44" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0" FontSize="14" Cursor="Hand" Click="MinimizeClick" />
                    <Button Content="✕" Width="46" Height="44" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0" FontSize="13" Cursor="Hand" Click="CloseClick" />
                </StackPanel>
            </Grid>

            <!-- Navigation + Server Status Header -->
            <Border Grid.Row="1" Background="#0E1420" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="PLAY" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Play" Tag="{Binding IsPlayTab}" Margin="0,0,6,0" />
                        <Button Content="GRAPHICS &amp; SETTINGS" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Settings" Tag="{Binding IsSettingsTab}" Margin="0,0,6,0" />
                        <Button Content="SETUP &amp; DIAGNOSTICS" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Setup" Tag="{Binding IsSetupTab}" Margin="0,0,6,0" />
                        <Button Content="IN-GAME GUIDE" Style="{StaticResource NavTabButton}" Command="{Binding SelectTabCommand}" CommandParameter="Guide" Tag="{Binding IsGuideTab}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#131A26" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding ServerStatus.IsOnline, Converter={StaticResource BoolToStatusBrush}}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding EffectiveHost}" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ServerStatus.SummaryText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Button Content="↻" ToolTip="Refresh Server Status" Style="{StaticResource SecondaryButton}" Padding="10,5" Command="{Binding RefreshStatusCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Tab Content -->
            <Grid Grid.Row="2" Margin="20,16">

                <!-- TAB 1: PLAY -->
                <Grid Visibility="{Binding IsPlayTab, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="24,20" Margin="0,0,0,16" BorderBrush="#2E3B54" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#162033" Offset="0" />
                                <GradientStop Color="#0F1726" Offset="0.6" />
                                <GradientStop Color="#11222C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding ServerName}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" />
                                <TextBlock Text="{Binding Tagline}" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A2B3C" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="12" Foreground="{StaticResource CyanAccent}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#1A2334" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="Ashita v4  •  Pivot DAT Overlay  •  overlords_talents" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="{Binding PlayButtonText}" Style="{StaticResource PrimaryPlayButton}" Command="{Binding PlayCommand}" MinWidth="220" />
                                <Button Content="Check / Sync Updates" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdatesCommand}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Two Columns: Account Launch + News/Log -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Account & Quick Options -->
                        <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ACCOUNT &amp; LAUNCH" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,12" />

                                    <TextBlock Text="Username (optional)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                    <TextBlock Text="Password (optional)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="AccountPasswordBox" PasswordChanged="AccountPasswordBox_OnPasswordChanged" Margin="0,0,0,10" />

                                    <CheckBox Content="Remember password (Windows DPAPI encrypted)" IsChecked="{Binding RememberPassword}" />
                                    <CheckBox Content="Auto-login via xiloader arguments" IsChecked="{Binding AutoLogin}" />
                                    <CheckBox Content="Auto-load overlords_talents (/talents)" IsChecked="{Binding AutoLoadTalentsAddon}" />
                                    <CheckBox Content="Enable Pivot DAT overlay (Call Eos)" IsChecked="{Binding EnablePivotOverlay}" />
                                    <CheckBox Content="Close launcher when game starts" IsChecked="{Binding AutoCloseOnLaunch}" />

                                    <Border Background="#0E1420" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                        <TextBlock Text="First time joining? Leave Auto-login unchecked to create your account directly inside the xiloader console window."
                                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Column: News + Activity Log -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="175" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PATCH NOTES &amp; ANNOUNCEMENTS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding NewsItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" />
                                                                <TextBlock Text="{Binding Date}" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource CyanAccent}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ACTIVITY LOG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" Background="#0B0F17" Foreground="{StaticResource TextSecondary}"
                                             BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" FontFamily="Consolas" FontSize="11.5" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- TAB 2: GRAPHICS & SETTINGS -->
                <ScrollViewer Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Settings Column: Connection + Paths -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="SERVER CONNECTION" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />
                                        <CheckBox Content="Override default server host" IsChecked="{Binding UseCustomServer}" Margin="0,0,0,8" />

                                        <TextBlock Text="Server Host / IP" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding CustomServerHost, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomServer}" Margin="0,0,0,8" />

                                        <CheckBox Content="Pass --hairpin to xiloader (for external/NAT connections)" IsChecked="{Binding CustomUseHairpin}" IsEnabled="{Binding UseCustomServer}" Margin="0,0,0,8" />

                                        <Grid IsEnabled="{Binding UseCustomServer}" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Lobby TCP Port" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CustomLobbyPort}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Search TCP Port" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding CustomSearchPort}" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Export Shareable overlords-server.json" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ExportServerOverrideCommand}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="PATHS &amp; OVERLAY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />

                                        <TextBlock Text="FINAL FANTASY XI Folder" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding FfxiPath}" />
                                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFfxiCommand}" />
                                        </Grid>

                                        <TextBlock Text="Ashita v4 Folder" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding AshitaPath}" />
                                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseAshitaCommand}" />
                                            <Button Grid.Column="4" Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding OpenAshitaFolderCommand}" />
                                        </Grid>

                                        <CheckBox Content="Also copy DAT overlay to external folder (e.g. C:\DATs\Overlords)" IsChecked="{Binding SyncToCustomDatFolder}" />
                                        <Grid IsEnabled="{Binding SyncToCustomDatFolder}" Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding CustomDatOverlayPath}" />
                                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCustomDatCommand}" />
                                        </Grid>

                                        <CheckBox Content="Check for OverlordsXI updates on startup" IsChecked="{Binding AutoCheckUpdatesOnStartup}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Settings Column: Graphics & Audio -->
                            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="DISPLAY, GRAPHICS &amp; AUDIO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />

                                    <TextBlock Text="Quick Resolution Presets" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="720p" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="720p" Margin="0,0,6,0" />
                                        <Button Content="1080p" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="1080p" Margin="0,0,6,0" />
                                        <Button Content="1440p" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="1440p" Margin="0,0,6,0" />
                                        <Button Content="4K" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="4k" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Window Mode" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding SelectedWindowMode}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FPS Cap" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding FpsCapOptions}" SelectedItem="{Binding SelectedFpsCap}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource FpsLabel}}" Foreground="#0B0F17" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Client Region" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Window Width / Height" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding WindowWidth}" />
                                                <TextBox Grid.Column="2" Text="{Binding WindowHeight}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Menu Width / Height" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding MenuWidth}" />
                                                <TextBox Grid.Column="2" Text="{Binding MenuHeight}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Background Supersampling W / H" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding BackgroundWidth}" />
                                                <TextBox Grid.Column="2" Text="{Binding BackgroundHeight}" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mip Mapping (0-6)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding MipMapping}" />
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <CheckBox Content="Uncompressed Textures" IsChecked="{Binding UncompressedTextures}" />
                                        <CheckBox Content="Uncompressed Maps" IsChecked="{Binding UncompressedMaps}" />
                                        <CheckBox Content="High-Quality Fonts" IsChecked="{Binding HighQualityFonts}" />
                                        <CheckBox Content="Hardware Mouse" IsChecked="{Binding HardwareMouse}" />
                                        <CheckBox Content="Bump Mapping" IsChecked="{Binding BumpMapping}" />
                                        <CheckBox Content="Show Opening Movie" IsChecked="{Binding ShowOpeningMovie}" />
                                        <CheckBox Content="Game Sound Enabled" IsChecked="{Binding SoundEnabled}" />
                                        <CheckBox Content="Background Audio" IsChecked="{Binding BackgroundSound}" />
                                    </UniformGrid>

                                    <Button Content="Save Settings" Style="{StaticResource PrimaryPlayButton}" Padding="18,10" FontSize="14"
                                            Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 3: SETUP & DIAGNOSTICS -->
                <ScrollViewer Visibility="{Binding IsSetupTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CLIENT ENVIRONMENT &amp; PREREQUISITES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" />
                                        <TextBlock Text="Everything needed to join OverlordsXI cleanly via Ashita v4 + XIPivot." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Re-Scan" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDiagnosticsCommand}" Margin="0,0,8,0" />
                                        <Button Content="Install / Repair Ashita + Tools" Style="{StaticResource PrimaryPlayButton}" Padding="16,8" FontSize="13"
                                                Command="{Binding InstallPrerequisitesCommand}" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2">
                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FINAL FANTASY XI Installation" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{Binding Diagnostics.DetectedFfxiPath}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.FfxiDetected, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.FfxiDetected, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Ashita v4 (Ashita-cli.exe)" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{Binding AshitaPath}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.AshitaInstalled, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.AshitaInstalled, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="xiloader.exe (LandSandBoat Bootloader)" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="{Binding Diagnostics.XiloaderPath}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.XiloaderInstalled, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.XiloaderInstalled, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="XIPivot Plugin (polplugins\pivot.dll)" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Required to load Call Eos / Orphic Egg DAT overlay" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.PivotPluginInstalled, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.PivotPluginInstalled, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="overlords_talents Addon" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Ashita v4 ImGui Talent Tree UI (/talents)" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.TalentsAddonSynced, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.TalentsAddonSynced, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="OverlordsXI DAT Overlay" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="ROM/118 &amp; ROM/181 client text/ability tables" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.DatOverlaySynced, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.DatOverlaySynced, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Windows DirectPlay Feature" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Required by FFXI (Legacy Components -> DirectPlay)" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.DirectPlayEnabled, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.DirectPlayEnabled, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="VC++ Redistributable (x86)" FontWeight="Bold" FontSize="13" />
                                                <TextBlock Text="Required by 32-bit FFXI, Ashita, and XIPivot" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Diagnostics.VcRedistX86Present, Converter={StaticResource BoolToReadyText}}"
                                                       Foreground="{Binding Diagnostics.VcRedistX86Present, Converter={StaticResource BoolToStatusBrush}}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Force Re-Sync All OverlordsXI Files" Style="{StaticResource SecondaryButton}" Command="{Binding RepairFilesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 4: IN-GAME GUIDE -->
                <ScrollViewer Visibility="{Binding IsGuideTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="WEAPONSKILL TALENT TREES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,12">
                                    All 207 player weaponskills are unlocked at level 1 and scale via 4-tier (56-point) bespoke job-themed talent trees and pickable skillchain augments.
                                </TextBlock>
                                <Border Background="#0E1420" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="/talents  (or /tal) — Open the Ashita v4 Talent Tree UI" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource CyanAccent}" Margin="0,0,0,4" />
                                        <TextBlock Text="/talents sync — Force resync points &amp; catalog from server" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="!talent — Server-side fallback menu without the addon" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="SCHOLAR: CALL EOS &amp; SPECS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,6,0,8" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,12">
                                    Call Eos summons a real faerie pet that maintains stackable Regen and removes debuffs (-na / Erase). Equip Orphic Egg for level-scaling Eos Refresh.
                                </TextBlock>
                                <Border Background="#0E1420" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="!spec  /  !spec list — View available job specs" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource CyanAccent}" Margin="0,0,0,4" />
                                        <TextBlock Text="!spec set medic — AoE Cure/Regen + double Sublimation" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="!spec set sage — Permanent Ebullience + 2h boosted Helix" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="!eos heal  /  !eos dismiss — Control Eos manually" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="FIRST-TIME PLAYER CHECKLIST" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldAccent}" Margin="0,0,0,10" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    1. Ensure FINAL FANTASY XI is installed and patched on your PC.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    2. Enable Windows DirectPlay (Turn Windows features on or off -> Legacy Components -> DirectPlay).
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    3. Click PLAY OVERLORDSXI — the launcher automatically downloads Ashita v4, xiloader.exe, XIPivot, the OverlordsXI DAT overlay, and overlords_talents if missing.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10">
                                    4. On your first launch, leave Auto-login unchecked and choose option 2 in xiloader to create an account on the server.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13">
                                    5. For the best alt-tab stability on Windows 10/11, keep Window Mode set to Borderless or Windowed.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Status & Progress Footer -->
            <Border Grid.Row="3" Background="#080B12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Background="#161E2E" Foreground="{StaticResource CyanAccent}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
