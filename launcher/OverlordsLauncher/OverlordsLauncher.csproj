<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OverlordsLauncher</AssemblyName>
    <RootNamespace>OverlordsLauncher</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>OverlordsXI Launcher</AssemblyTitle>
    <Product>OverlordsXI Launcher</Product>
    <Company>OverlordsXI</Company>
    <Description>Distributable Ashita v4 client launcher and auto-updater for OverlordsXI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\manifest.json" Link="Resources\manifest.json" />
  </ItemGroup>

</Project>
