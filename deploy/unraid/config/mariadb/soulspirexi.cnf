# SoulspireXI MariaDB 10.11 Configuration for Unraid Docker
# Matches Windows MariaDB 10.11.10 charset, collation, sql_mode, and case-insensitivity.

[mysqld]
# Character set & collation parity with Windows xidb
character-set-server = utf8mb4
collation-server     = utf8mb4_general_ci

# Windows MariaDB uses lower_case_table_names=1; preserve on Linux for table-name parity
# NOTE: Must be present before first database initialization of /var/lib/mysql.
lower_case_table_names = 1

# Match Windows MariaDB 10.11.10 sql_mode
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# Networking — MariaDB is only reachable via loopback/private Docker network
skip-name-resolve
max_connections = 200
max_allowed_packet = 64M

# InnoDB tuning for Unraid SSD/cache appdata
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

# Slow query diagnostics
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

[client]
default-character-set = utf8mb4
