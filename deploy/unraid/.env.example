###############################################################################
# SoulspireXI — Unraid Docker Environment Configuration Template
#
# Copy to .env on Unraid (NEVER commit .env to Git!):
#   cp .env.example .env && chmod 600 .env
###############################################################################

# Image & Version Pinning
OVERLORDS_IMAGE=overlordsxi/server
OVERLORDS_TAG=v2026.11.19
MARIADB_VERSION=10.11

# Unraid Persistent Storage Root
APPDATA_DIR=/mnt/user/appdata/overlordsxi

# Timezone (matches Windows server)
TZ=America/Chicago

# Unraid File Ownership (nobody:users = 99:100)
PUID=99
PGID=100

# MariaDB Credentials — REPLACE WITH STRONG RANDOM PASSWORDS!
# Generate with: openssl rand -base64 32
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MARIADB_DATABASE=xidb
MARIADB_USER=overlords
MARIADB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# Advertised FFXI Zone IPv4 (stored in zone_settings.zoneip)
#   - Phase 5 Local LAN Staging: set to Unraid's LAN IPv4 (e.g. 192.168.1.50)
#   - Phase 6-11 Production:     set to VPS PUBLIC IPv4 (NEVER residential IP!)
OVERLORDS_ZONE_IP=127.0.0.1

# Optional LandSandBoat HTTP API (keep false unless needed internally)
XI_NETWORK_ENABLE_HTTP=false

# Backup Retention Policy
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=4
# Optional off-host backup destination (rclone remote or rsync target, e.g. "b2:overlordsxi-backups")
OFFHOST_BACKUP_CMD=
