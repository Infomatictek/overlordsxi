+namespace
+{
+constexpr auto isValidCrystalBranch(uint8 mjob, uint8 branch) -> bool
+{
+    switch (mjob)
+    {
+        case 1:  // WAR: Commander (1), Berserker (2), Gladiator (3)
+        case 2:  // MNK: Sensei (1), Black Belt (2), Chi Weaver (3)
+        case 10: // BRD: Adventurer (1), Musician (2), Minstrel (3)
+        case 22: // RUN: Inquisitor (1), Spellblade (2), Lifebinder (3)
+            return branch >= 1 && branch <= 3;
+        case 20: // SCH: Medic (1), Sage (2)
+            return branch >= 1 && branch <= 2;
+        case 4:  // BLM: Necromancer (1)
+        case 19: // DNC: Bladewheel (1)
+            return branch == 1;
+        default:
+            return false;
+    }
+}
+} // namespace
