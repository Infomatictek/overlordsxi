diff --git a/src/map/utils/primalist_actions.h b/src/map/utils/primalist_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/primalist_actions.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <array>
+
+#include "ability.h"
+#include "entities/char_entity.h"
+#include "spell.h"
+#include "utils/petutils.h"
+
+namespace primalist
+{
+struct Avatar
+{
+    SpellID spell;
+    uint32  pet;
+    uint16  pact;
+};
+
+inline constexpr std::array<Avatar, 7> avatars =
+{
+    Avatar{ SpellID::Carbuncle, PETID_CARBUNCLE, 516 },
+    Avatar{ SpellID::Ifrit, PETID_IFRIT, 545 },
+    Avatar{ SpellID::Titan, PETID_TITAN, 561 },
+    Avatar{ SpellID::Leviathan, PETID_LEVIATHAN, 577 },
+    Avatar{ SpellID::Garuda, PETID_GARUDA, 593 },
+    Avatar{ SpellID::Shiva, PETID_SHIVA, 609 },
+    Avatar{ SpellID::Ramuh, PETID_RAMUH, 625 },
+};
+
+inline auto isActive(const CCharEntity* entity) -> bool
+{
+    return entity && entity->GetMJob() == xi::Job::SMN && entity->GetMLevel() >= 10 &&
+           entity->GetLocalVar("OX_PRM_ACTIVE") == 1;
+}
+
+inline auto spellLevel(const CCharEntity* entity, SpellID id) -> uint8
+{
+    if (id == SpellID::Carbuncle || id == SpellID::Ifrit)
+    {
+        return 10;
+    }
+    const auto spell = static_cast<uint16>(id);
+    if (spell >= static_cast<uint16>(SpellID::Titan) && spell <= static_cast<uint16>(SpellID::Ramuh))
+    {
+        if (entity->GetMLevel() >= 50)
+        {
+            return 50;
+        }
+        if (spell == entity->GetLocalVar("OX_PRM_CHOICE_A") || spell == entity->GetLocalVar("OX_PRM_CHOICE_B"))
+        {
+            return 30;
+        }
+    }
+    return 0;
+}
+
+inline auto pactForPet(const CCharEntity* entity, uint32 petID) -> uint16
+{
+    for (const auto& avatar : avatars)
+    {
+        if (avatar.pet == petID)
+        {
+            const auto unlock = spellLevel(entity, avatar.spell);
+            return unlock != 0 && entity->GetMLevel() >= unlock ? avatar.pact : 0;
+        }
+    }
+    return 0;
+}
+
+inline auto isPact(uint16 id) -> bool
+{
+    for (const auto& avatar : avatars)
+    {
+        if (avatar.pact == id)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline auto playerAbility(uint16 id, uint8 level) -> bool
+{
+    switch (id)
+    {
+        case ABILITY_ASSAULT:
+        case ABILITY_RETREAT:
+        case ABILITY_RELEASE:
+        case ABILITY_BLOOD_PACT_RAGE:
+            return true;
+        case ABILITY_ELEMENTAL_SIPHON:
+        case ABILITY_MANA_CEDE:
+            return level >= 30 && level < 50;
+        default:
+            return false;
+    }
+}
+} // namespace primalist
