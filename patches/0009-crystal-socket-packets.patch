+#include "0x1ff_crystal_collection.h"
+
+#include "common/logging.h"
+#include "common/utils.h"
+#include "entities/char_entity.h"
+#include "lua/luautils.h"
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+
+namespace
+{
+auto sanitizeField(std::string value) -> std::string
+{
+    std::replace(value.begin(), value.end(), '\x1f', ' ');
+    std::replace(value.begin(), value.end(), '\r', ' ');
+    std::replace(value.begin(), value.end(), '\n', ' ');
+    return value;
+}
+
+void pushChunkedCatalogPacket(CCharEntity*         PChar,
+                              crystal::CatalogKind kind,
+                              uint16_t             requestId,
+                              uint8_t              jobId,
+                              uint8_t              branchId,
+                              uint8_t              index,
+                              uint8_t              reqLevel,
+                              std::string_view     text)
+{
+    constexpr size_t MaxChunkBytes = sizeof(GP_SERV_COMMAND_CRYSTAL_CATALOG::PacketData::payload);
+    size_t           offset        = 0;
+    uint8_t          chunkIdx      = 0;
+
+    do
+    {
+        const size_t  remaining = text.size() - offset;
+        const size_t  len       = std::min(remaining, MaxChunkBytes);
+        const uint8_t more      = (offset + len < text.size()) ? 1 : 0;
+        PChar->pushPacket<GP_SERV_COMMAND_CRYSTAL_CATALOG>(kind,
+                                                           requestId,
+                                                           jobId,
+                                                           branchId,
+                                                           index,
+                                                           reqLevel,
+                                                           chunkIdx,
+                                                           more,
+                                                           text.substr(offset, len));
+        offset += len;
+        ++chunkIdx;
+    } while (offset < text.size());
+}
+} // namespace
+
+GP_SERV_COMMAND_CRYSTAL_COLLECTION::GP_SERV_COMMAND_CRYSTAL_COLLECTION(CCharEntity* PChar, crystal::Result result, uint16_t requestId)
+{
+    auto& packet          = this->data();
+    packet.magic          = crystal::Magic;
+    packet.version        = 1;
+    packet.result         = result;
+    packet.requestId      = requestId;
+    packet.currentMainJob = static_cast<uint8_t>(PChar->GetMJob());
+    packet.entryCount     = crystal::MaxJobs;
+    packet.currentMainLvl = static_cast<uint8_t>(PChar->GetMLevel());
+    packet.reserved       = 0;
+
+    auto specTable = lua["xi"]["overlords"]["spec"];
+    if (!specTable.valid())
+    {
+        return;
+    }
+
+    sol::protected_function snapshotFn = specTable["getCrystalSnapshot"];
+    if (!snapshotFn.valid())
+    {
+        return;
+    }
+
+    const auto luaResult = snapshotFn(PChar);
+    if (!luaResult.valid())
+    {
+        sol::error err = luaResult;
+        ShowError("crystal_socket: getCrystalSnapshot failed: %s", err.what());
+        return;
+    }
+
+    const sol::table snapshot = luaResult;
+    if (!snapshot.valid())
+    {
+        return;
+    }
+
+    const sol::table jobs = snapshot["jobs"];
+    if (!jobs.valid())
+    {
+        return;
+    }
+
+    for (uint8_t jobId = 1; jobId < crystal::MaxJobs; ++jobId)
+    {
+        const sol::table entry = jobs[jobId];
+        if (!entry.valid())
+        {
+            continue;
+        }
+
+        const uint8_t ownedMask    = entry.get_or<uint8_t>("ownedMask", 0);
+        const uint8_t activeBranch = entry.get_or<uint8_t>("activeBranch", 0);
+
+        packet.entries[jobId].ownedMask    = ownedMask & 0xFE;
+        packet.entries[jobId].activeBranch = activeBranch <= crystal::MaxBranches ? activeBranch : 0;
+    }
+}
+
+GP_SERV_COMMAND_CRYSTAL_CATALOG::GP_SERV_COMMAND_CRYSTAL_CATALOG(crystal::CatalogKind kind,
+                                                                 uint16_t             requestId,
+                                                                 uint8_t              jobId,
+                                                                 uint8_t              branchId,
+                                                                 uint8_t              index,
+                                                                 uint8_t              reqLevel,
+                                                                 uint8_t              chunkIdx,
+                                                                 uint8_t              chunkFlag,
+                                                                 std::string_view     text)
+{
+    auto& packet     = this->data();
+    packet.magic     = crystal::CatalogMagic;
+    packet.version   = 1;
+    packet.kind      = kind;
+    packet.requestId = requestId;
+    packet.jobId     = jobId;
+    packet.branchId  = branchId;
+    packet.index     = index;
+    packet.reqLevel  = reqLevel;
+    packet.chunkIdx  = chunkIdx;
+    packet.chunkFlag = chunkFlag;
+
+    const auto copyLen = static_cast<uint16_t>(std::min(text.size(), sizeof(packet.payload)));
+    packet.textLen     = copyLen;
+    if (copyLen > 0)
+    {
+        std::memcpy(packet.payload, text.data(), copyLen);
+    }
+
+    const auto packetSize = sizeof(GP_SERV_HEADER) + offsetof(PacketData, payload) + copyLen;
+    this->setSize(roundUpToNearestFour(packetSize));
+}
+
+namespace crystal
+{
+void pushCatalogPackets(CCharEntity* PChar, uint16_t requestId, uint8_t targetJob)
+{
+    if (!PChar || targetJob == 0 || targetJob >= MaxJobs)
+    {
+        return;
+    }
+
+    auto specTable = lua["xi"]["overlords"]["spec"];
+    if (!specTable.valid())
+    {
+        return;
+    }
+
+    sol::protected_function catalogFn = specTable["getCrystalCatalog"];
+    if (!catalogFn.valid())
+    {
+        return;
+    }
+
+    const auto luaResult = catalogFn(PChar, targetJob);
+    if (!luaResult.valid())
+    {
+        sol::error err = luaResult;
+        ShowError("crystal_socket: getCrystalCatalog failed: %s", err.what());
+        return;
+    }
+
+    const sol::table catalog = luaResult;
+    if (!catalog.valid())
+    {
+        return;
+    }
+
+    const std::string jobName    = sanitizeField(catalog.get_or<std::string>("jobName", ""));
+    const sol::table  entries    = catalog["entries"];
+    const uint8_t     entryCount = entries.valid() ? static_cast<uint8_t>(std::min<size_t>(entries.size(), MaxBranches)) : 0;
+
+    pushChunkedCatalogPacket(PChar, CatalogKind::BeginJob, requestId, targetJob, 0, entryCount, 0, jobName);
+
+    if (entries.valid())
+    {
+        for (size_t i = 1; i <= entryCount; ++i)
+        {
+            const sol::table entry = entries[i];
+            if (!entry.valid())
+            {
+                continue;
+            }
+
+            const uint8_t     branchId = entry.get_or<uint8_t>("id", 0);
+            const uint8_t     reqLevel = entry.get_or<uint8_t>("reqLevel", 10);
+            const std::string key      = sanitizeField(entry.get_or<std::string>("key", ""));
+            const std::string name     = sanitizeField(entry.get_or<std::string>("name", ""));
+            const std::string role     = sanitizeField(entry.get_or<std::string>("role", ""));
+            const std::string icon     = sanitizeField(entry.get_or<std::string>("icon", ""));
+            const std::string desc     = sanitizeField(entry.get_or<std::string>("description", ""));
+
+            const std::string packed = key + "\x1f" + name + "\x1f" + role + "\x1f" + icon + "\x1f" + desc;
+            pushChunkedCatalogPacket(PChar, CatalogKind::Entry, requestId, targetJob, branchId, static_cast<uint8_t>(i), reqLevel, packed);
+
+            const sol::table highlights = entry["highlights"];
+            if (highlights.valid())
+            {
+                const size_t hlCount = std::min<size_t>(highlights.size(), 255);
+                for (size_t h = 1; h <= hlCount; ++h)
+                {
+                    const sol::object hlObj = highlights[h];
+                    if (hlObj.is<std::string>())
+                    {
+                        const std::string line = sanitizeField(hlObj.as<std::string>());
+                        pushChunkedCatalogPacket(PChar,
+                                                 CatalogKind::Highlight,
+                                                 requestId,
+                                                 targetJob,
+                                                 branchId,
+                                                 static_cast<uint8_t>(h),
+                                                 0,
+                                                 line);
+                    }
+                }
+            }
+        }
+    }
+
+    pushChunkedCatalogPacket(PChar, CatalogKind::EndJob, requestId, targetJob, 0, entryCount, 0, "");
+}
+} // namespace crystal
