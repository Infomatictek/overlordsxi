+#include "map/crystal_socket.h"
+#include <catch2/catch_test_macros.hpp>
+
+TEST_CASE("Crystal socket validates before changing selection", "[crystal]")
+{
+    using namespace crystal;
+    constexpr uint8_t warMask = 0x0E; // Branches 1, 2, 3
+    constexpr uint8_t mnkMask = 0x02; // Branch 1 (Sensei)
+    constexpr uint8_t schMask = 0x06; // Branches 1, 2 (Medic, Sage)
+
+    CHECK(selectionResult(1, 1, 1, 0, false, warMask) == Result::Locked);
+    CHECK(selectionResult(1, 1, 1, 2, false, warMask) == Result::Success);
+    CHECK(selectionResult(1, 1, 0, 0, false, warMask) == Result::Success);
+    CHECK(selectionResult(2, 1, 1, warMask, false, warMask) == Result::WrongJob);
+    CHECK(selectionResult(1, 3, 1, warMask, false, 0) == Result::Invalid);
+    CHECK(selectionResult(1, 1, 4, warMask, false, warMask) == Result::Invalid);
+    CHECK(selectionResult(1, 1, 1, warMask, true, warMask) == Result::Busy);
+    CHECK(selectionResult(1, 1, 0, warMask, true, warMask) == Result::Busy);
+    CHECK(selectionResult(2, 2, 1, mnkMask, false, mnkMask) == Result::Success);
+    CHECK(selectionResult(2, 2, 2, mnkMask, false, mnkMask) == Result::Invalid);
+    CHECK(selectionResult(20, 20, 2, schMask, false, schMask) == Result::Success);
+    CHECK(selectionResult(20, 20, 3, schMask, false, schMask) == Result::Invalid);
+
+    for (uint8_t branch = 1; branch <= 3; ++branch)
+    {
+        CHECK(selectionResult(1, 1, branch, 1 << branch, false, warMask) == Result::Success);
+    }
+
+    CHECK(validRequest(Magic, 1, 0, 0));
+    CHECK(validRequest(Magic, 1, 2, 0));
+    CHECK_FALSE(validRequest(0, 1, 0, 0));
+    CHECK_FALSE(validRequest(Magic, 2, 0, 0));
+    CHECK_FALSE(validRequest(Magic, 1, 3, 0));
+    CHECK_FALSE(validRequest(Magic, 1, 0, 1));
+}
