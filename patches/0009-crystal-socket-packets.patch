+auto GP_CLI_COMMAND_CRYSTAL_SOCKET::validate(MapSession* PSession, const CCharEntity* PChar) const -> PacketValidationResult
+{
+    return PacketValidator(PChar).mustEqual(magic, crystal::Magic, "Not a Crystal protocol request.");
+}
+
+void GP_CLI_COMMAND_CRYSTAL_SOCKET::process(MapSession* PSession, CCharEntity* PChar) const
+{
+    auto result = crystal::Result::Invalid;
+    if (crystal::validRequest(magic, version, operation, reserved))
+    {
+        if (operation == std::to_underlying(crystal::Operation::Query))
+        {
+            result = crystal::Result::Success;
+        }
+        else if (operation == std::to_underlying(crystal::Operation::SyncCatalog))
+        {
+            const uint8_t targetJob = job == 0 ? static_cast<uint8_t>(PChar->GetMJob()) : job;
+            if (targetJob > 0 && targetJob < crystal::MaxJobs)
+            {
+                crystal::pushCatalogPackets(PChar, requestId, targetJob);
+                result = crystal::Result::Success;
+            }
+        }
+        else if (operation == std::to_underlying(crystal::Operation::Select))
+        {
+            const PacketValidationResult state = PacketValidator(PChar).blockedBy({
+                BlockedState::Dead,
+                BlockedState::InEvent,
+                BlockedState::Engaged,
+                BlockedState::AbnormalStatus,
+                BlockedState::PreventAction,
+                BlockedState::Crafting,
+                BlockedState::Fishing,
+                BlockedState::Healing,
+                BlockedState::Mounted,
+                BlockedState::Charmed,
+                BlockedState::Monstrosity,
+            });
+
+            // Conservatively forbid battlefield changes and active/queued actions.
+            const bool busy = !PSession->hasLoadedZone() ||
+                              PSession->shuttingDown ||
+                              PSession->zone_type != GP_GAME_LOGOUT_STATE::NONE ||
+                              !state.valid() ||
+                              !PChar->loc.zone ||
+                              PChar->PBattlefield ||
+                              !PChar->PAI->IsStateStackEmpty() ||
+                              !PChar->PAI->QueueEmpty() ||
+                              PChar->hasEnmityEXPENSIVE();
+
+            auto specTable = lua["xi"]["overlords"]["spec"];
+            if (specTable.valid())
+            {
+                sol::protected_function selectFn = specTable["handleCrystalSelect"];
+                if (selectFn.valid())
+                {
+                    const auto luaResult = selectFn(PChar, job, branch, busy);
+                    if (luaResult.valid())
+                    {
+                        const uint8_t code = luaResult.get<uint8_t>();
+                        if (code <= std::to_underlying(crystal::Result::Invalid))
+                        {
+                            result = static_cast<crystal::Result>(code);
+                        }
+                    }
+                    else
+                    {
+                        sol::error err = luaResult;
+                        ShowError("crystal_socket: handleCrystalSelect failed: %s", err.what());
+                    }
+                }
+            }
+        }
+    }
+
+    // Only reply to a request, keeping stock clients unaware of the extension.
+    PChar->pushPacket<GP_SERV_COMMAND_CRYSTAL_COLLECTION>(PChar, result, requestId);
+}
