+#include "map/crystal_socket.h"
+#include <catch2/catch_test_macros.hpp>
+
+TEST_CASE("Crystal socket validates before changing selection", "[crystal]")
+{
+    using namespace crystal;
+    constexpr uint8_t warMask = 0x0E; // Branches 1, 2, 3
+    constexpr uint8_t mnkMask = 0x02; // Branch 1 (Sensei)
+    constexpr uint8_t schMask = 0x06; // Branches 1, 2 (Medic, Sage)
+
+    CHECK(selectionResult(1, 1, 1, 0, false, warMask) == Result::Locked);
+    CHECK(selectionResult(1, 1, 1, 2, false, warMask) == Result::Success);
+    CHECK(selectionResult(1, 1, 0, 0, false, warMask) == Result::Success);
+    CHECK(selectionResult(2, 1, 1, warMask, false, warMask) == Result::WrongJob);
+    CHECK(selectionResult(1, 3, 1, warMask, false, 0) == Result::Invalid);
+    CHECK(selectionResult(1, 1, 4, warMask, false, warMask) == Result::Invalid);
+    CHECK(selectionResult(1, 1, 1, warMask, true, warMask) == Result::Busy);
+    CHECK(selectionResult(1, 1, 0, warMask, true, warMask) == Result::Busy);
+    CHECK(selectionResult(2, 2, 1, mnkMask, false, mnkMask) == Result::Success);
+    CHECK(selectionResult(2, 2, 2, mnkMask, false, mnkMask) == Result::Invalid);
+    CHECK(selectionResult(20, 20, 2, schMask, false, schMask) == Result::Success);
+    CHECK(selectionResult(20, 20, 3, schMask, false, schMask) == Result::Invalid);
+
+    for (uint8_t branch = 1; branch <= 3; ++branch)
+    {
+        CHECK(selectionResult(1, 1, branch, 1 << branch, false, warMask) == Result::Success);
+    }
+
+    CHECK(validRequest(Magic, 1, 0, 0));
+    CHECK(validRequest(Magic, 1, 2, 0));
+    CHECK_FALSE(validRequest(0, 1, 0, 0));
+    CHECK_FALSE(validRequest(Magic, 2, 0, 0));
+    CHECK_FALSE(validRequest(Magic, 1, 3, 0));
+    CHECK_FALSE(validRequest(Magic, 1, 0, 1));
+}
+
+#include "map/crystal_socket_lua.h"
+
+TEST_CASE("Crystal socket Lua helpers handle sparse tables safely", "[crystal]")
+{
+    sol::state luaState;
+    luaState.open_libraries(sol::lib::base, sol::lib::table);
+
+    CHECK_FALSE(crystal::getSpecTable(luaState).has_value());
+
+    luaState.script(R"(
+        xi = {
+            overlords = {
+                spec = {
+                    getCrystalSnapshot = function()
+                        return {
+                            jobs = {
+                                [1]  = { ownedMask = 0x0E, activeBranch = 2 },
+                                [2]  = { ownedMask = 0x05, activeBranch = 9 },
+                                [20] = { ownedMask = 0x02, activeBranch = 1 },
+                                [4]  = "not-a-table",
+                            },
+                        }
+                    end,
+                    getCrystalCatalog = function()
+                        return {
+                            jobName = "Scholar\n",
+                            entries = {
+                                {
+                                    id = 1,
+                                    key = "sch_sage",
+                                    name = "Sage",
+                                    role = "Caster",
+                                    icon = "sch_sage",
+                                    description = "Line1\r\nLine2",
+                                },
+                                "invalid-entry",
+                                {
+                                    id = 2,
+                                    reqLevel = 30,
+                                    key = "sch_medic",
+                                    name = "Medic",
+                                    highlights = { "Triage\x1fBurst", 123 },
+                                },
+                            },
+                        }
+                    end,
+                },
+            },
+        }
+    )");
+
+    const auto specTbl = crystal::getSpecTable(luaState);
+    REQUIRE(specTbl.has_value());
+    CHECK_FALSE(crystal::getProtectedFunction(*specTbl, "missingFn").has_value());
+
+    const auto snapFn = crystal::getProtectedFunction(*specTbl, "getCrystalSnapshot");
+    REQUIRE(snapFn.has_value());
+    const auto snapTbl = crystal::getProtectedTableResult((*snapFn)());
+    REQUIRE(snapTbl.has_value());
+
+    const auto parsedSnap = crystal::parseCrystalSnapshot(*snapTbl);
+    CHECK(parsedSnap[1].ownedMask == 0x0E);
+    CHECK(parsedSnap[1].activeBranch == 2);
+    CHECK(parsedSnap[2].ownedMask == 0x04);
+    CHECK(parsedSnap[2].activeBranch == 0);
+    CHECK(parsedSnap[3].ownedMask == 0);
+    CHECK(parsedSnap[3].activeBranch == 0);
+    CHECK(parsedSnap[4].ownedMask == 0);
+    CHECK(parsedSnap[20].ownedMask == 0x02);
+    CHECK(parsedSnap[20].activeBranch == 1);
+
+    const auto emptyCatalog = crystal::parseCrystalCatalog(luaState.create_table());
+    CHECK(emptyCatalog.jobName.empty());
+    CHECK(emptyCatalog.entries.empty());
+
+    const auto catFn = crystal::getProtectedFunction(*specTbl, "getCrystalCatalog");
+    REQUIRE(catFn.has_value());
+    const auto catTbl = crystal::getProtectedTableResult((*catFn)());
+    REQUIRE(catTbl.has_value());
+
+    const auto parsedCat = crystal::parseCrystalCatalog(*catTbl);
+    CHECK(parsedCat.jobName == "Scholar ");
+    REQUIRE(parsedCat.entries.size() == 2);
+    CHECK(parsedCat.entries[0].branchId == 1);
+    CHECK(parsedCat.entries[0].description == "Line1  Line2");
+    CHECK(parsedCat.entries[0].highlights.empty());
+    CHECK(parsedCat.entries[1].branchId == 2);
+    CHECK(parsedCat.entries[1].reqLevel == 30);
+    REQUIRE(parsedCat.entries[1].highlights.size() == 1);
+    CHECK(parsedCat.entries[1].highlights[0] == "Triage Burst");
+}
