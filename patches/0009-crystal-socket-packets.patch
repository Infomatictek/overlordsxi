+
+#include "0x1ff_crystal_collection.h"
+
+#include "common/logging.h"
+#include "common/utils.h"
+#include "crystal_socket_lua.h"
+#include "entities/char_entity.h"
+#include "lua/luautils.h"
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+
+namespace
+{
+void pushChunkedCatalogPacket(CCharEntity*         PChar,
+                              crystal::CatalogKind kind,
+                              uint16_t             requestId,
+                              uint8_t              jobId,
+                              uint8_t              branchId,
+                              uint8_t              index,
+                              uint8_t              reqLevel,
+                              std::string_view     text)
+{
+    constexpr size_t MaxChunkBytes = sizeof(GP_SERV_COMMAND_CRYSTAL_CATALOG::PacketData::payload);
+    size_t           offset        = 0;
+    uint8_t          chunkIdx      = 0;
+
+    do
+    {
+        const size_t  remaining = text.size() - offset;
+        const size_t  len       = std::min(remaining, MaxChunkBytes);
+        const uint8_t more      = (offset + len < text.size()) ? 1 : 0;
+        PChar->pushPacket<GP_SERV_COMMAND_CRYSTAL_CATALOG>(kind,
+                                                           requestId,
+                                                           jobId,
+                                                           branchId,
+                                                           index,
+                                                           reqLevel,
+                                                           chunkIdx,
+                                                           more,
+                                                           text.substr(offset, len));
+        offset += len;
+        ++chunkIdx;
+    } while (offset < text.size());
+}
+} // namespace
+
+GP_SERV_COMMAND_CRYSTAL_COLLECTION::GP_SERV_COMMAND_CRYSTAL_COLLECTION(CCharEntity* PChar, crystal::Result result, uint16_t requestId)
+{
+    auto& packet          = this->data();
+    packet.magic          = crystal::Magic;
+    packet.version        = 1;
+    packet.result         = result;
+    packet.requestId      = requestId;
+    packet.currentMainJob = static_cast<uint8_t>(PChar->GetMJob());
+    packet.entryCount     = crystal::MaxJobs;
+    packet.currentMainLvl = static_cast<uint8_t>(PChar->GetMLevel());
+    packet.reserved       = 0;
+
+    const auto specTable = crystal::getSpecTable(lua);
+    if (!specTable)
+    {
+        return;
+    }
+
+    const auto snapshotFn = crystal::getProtectedFunction(*specTable, "getCrystalSnapshot");
+    if (!snapshotFn)
+    {
+        return;
+    }
+
+    const auto luaResult = (*snapshotFn)(PChar);
+    if (!luaResult.valid())
+    {
+        const sol::error err = luaResult;
+        ShowError("crystal_socket: getCrystalSnapshot failed: %s", err.what());
+        return;
+    }
+
+    const auto snapshot = crystal::getProtectedTableResult(luaResult);
+    if (!snapshot)
+    {
+        return;
+    }
+
+    const auto parsed = crystal::parseCrystalSnapshot(*snapshot);
+    for (uint8_t jobId = 1; jobId < crystal::MaxJobs; ++jobId)
+    {
+        packet.entries[jobId].ownedMask    = parsed[jobId].ownedMask;
+        packet.entries[jobId].activeBranch = parsed[jobId].activeBranch;
+    }
+}
+
+GP_SERV_COMMAND_CRYSTAL_CATALOG::GP_SERV_COMMAND_CRYSTAL_CATALOG(crystal::CatalogKind kind,
+                                                                 uint16_t             requestId,
+                                                                 uint8_t              jobId,
+                                                                 uint8_t              branchId,
+                                                                 uint8_t              index,
+                                                                 uint8_t              reqLevel,
+                                                                 uint8_t              chunkIdx,
+                                                                 uint8_t              chunkFlag,
+                                                                 std::string_view     text)
+{
+    auto& packet     = this->data();
+    packet.magic     = crystal::CatalogMagic;
+    packet.version   = 1;
+    packet.kind      = kind;
+    packet.requestId = requestId;
+    packet.jobId     = jobId;
+    packet.branchId  = branchId;
+    packet.index     = index;
+    packet.reqLevel  = reqLevel;
+    packet.chunkIdx  = chunkIdx;
+    packet.chunkFlag = chunkFlag;
+
+    const auto copyLen = static_cast<uint16_t>(std::min(text.size(), sizeof(packet.payload)));
+    packet.textLen     = copyLen;
+    if (copyLen > 0)
+    {
+        std::memcpy(packet.payload, text.data(), copyLen);
+    }
+
+    const auto packetSize = sizeof(GP_SERV_HEADER) + offsetof(PacketData, payload) + copyLen;
+    this->setSize(roundUpToNearestFour(packetSize));
+}
+
+namespace crystal
+{
+void pushCatalogPackets(CCharEntity* PChar, uint16_t requestId, uint8_t targetJob)
+{
+    if (!PChar || targetJob == 0 || targetJob >= MaxJobs)
+    {
+        return;
+    }
+
+    const auto specTable = crystal::getSpecTable(lua);
+    if (!specTable)
+    {
+        return;
+    }
+
+    const auto catalogFn = crystal::getProtectedFunction(*specTable, "getCrystalCatalog");
+    if (!catalogFn)
+    {
+        return;
+    }
+
+    const auto luaResult = (*catalogFn)(PChar, targetJob);
+    if (!luaResult.valid())
+    {
+        const sol::error err = luaResult;
+        ShowError("crystal_socket: getCrystalCatalog failed: %s", err.what());
+        return;
+    }
+
+    const auto catalog = crystal::getProtectedTableResult(luaResult);
+    if (!catalog)
+    {
+        return;
+    }
+
+    const auto   parsed     = crystal::parseCrystalCatalog(*catalog);
+    const auto   entryCount = static_cast<uint8_t>(std::min<size_t>(parsed.entries.size(), MaxBranches));
+    pushChunkedCatalogPacket(PChar, CatalogKind::BeginJob, requestId, targetJob, 0, entryCount, 0, parsed.jobName);
+
+    for (size_t i = 0; i < entryCount; ++i)
+    {
+        const auto&       entry  = parsed.entries[i];
+        const std::string packed = entry.key + "\x1f" + entry.name + "\x1f" + entry.role + "\x1f" + entry.icon + "\x1f" + entry.description;
+        pushChunkedCatalogPacket(PChar, CatalogKind::Entry, requestId, targetJob, entry.branchId, static_cast<uint8_t>(i + 1), entry.reqLevel, packed);
+
+        for (size_t h = 0; h < entry.highlights.size(); ++h)
+        {
+            pushChunkedCatalogPacket(PChar,
+                                     CatalogKind::Highlight,
+                                     requestId,
+                                     targetJob,
+                                     entry.branchId,
+                                     static_cast<uint8_t>(h + 1),
+                                     0,
+                                     entry.highlights[h]);
+        }
+    }
+
+    pushChunkedCatalogPacket(PChar, CatalogKind::EndJob, requestId, targetJob, 0, entryCount, 0, "");
+}
+} // namespace crystal
