+        uint8_t              branchId;
+        uint8_t              index;
+        uint8_t              reqLevel;
+        uint8_t              chunkIdx;
+        uint8_t              chunkFlag;
+        uint16_t             textLen;
+        char                 payload[220];
+    };
+
+    GP_SERV_COMMAND_CRYSTAL_CATALOG(crystal::CatalogKind kind,
+                                    uint16_t             requestId,
+                                    uint8_t              jobId,
+                                    uint8_t              branchId,
+                                    uint8_t              index,
+                                    uint8_t              reqLevel,
+                                    uint8_t              chunkIdx,
+                                    uint8_t              chunkFlag,
+                                    std::string_view     text);
+};
+
+static_assert(sizeof(GP_SERV_COMMAND_CRYSTAL_CATALOG::PacketData) == 236);
+static_assert(offsetof(GP_SERV_COMMAND_CRYSTAL_CATALOG::PacketData, payload) == 16);
