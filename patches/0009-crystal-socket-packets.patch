+#pragma once
+
+#include "base.h"
+#include "crystal_socket.h"
+
+#include <cstddef>
+#include <string_view>
+
+class CCharEntity;
+
+class GP_SERV_COMMAND_CRYSTAL_COLLECTION final : public GP_SERV_PACKET<PacketS2C::GP_SERV_COMMAND_CRYSTAL_COLLECTION, GP_SERV_COMMAND_CRYSTAL_COLLECTION>
+{
+public:
+    struct Entry
+    {
+        uint8_t ownedMask;
+        uint8_t activeBranch;
+    };
+
+    struct PacketData
+    {
+        uint32_t        magic;
+        uint8_t         version;
+        crystal::Result result;
+        uint16_t        requestId;
+        uint8_t         currentMainJob;
+        uint8_t         entryCount;
+        uint8_t         currentMainLvl;
+        uint8_t         reserved;
+        Entry           entries[24];
+    };
+
+    GP_SERV_COMMAND_CRYSTAL_COLLECTION(CCharEntity* PChar, crystal::Result result, uint16_t requestId);
+};
+
+static_assert(sizeof(GP_SERV_COMMAND_CRYSTAL_COLLECTION::PacketData) == 60);
+static_assert(offsetof(GP_SERV_COMMAND_CRYSTAL_COLLECTION::PacketData, entries) == 12);
+
+class GP_SERV_COMMAND_CRYSTAL_CATALOG final : public GP_SERV_PACKET<PacketS2C::GP_SERV_COMMAND_CRYSTAL_COLLECTION, GP_SERV_COMMAND_CRYSTAL_CATALOG>
+{
+public:
+    struct PacketData
+    {
+        uint32_t             magic;
+        uint8_t              version;
+        crystal::CatalogKind kind;
+        uint16_t             requestId;
+        uint8_t              jobId;
+        uint8_t              branchId;
+        uint8_t              index;
+        uint8_t              reqLevel;
+        uint8_t              chunkIdx;
+        uint8_t              chunkFlag;
