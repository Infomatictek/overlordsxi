+
+#pragma once
+
+#include "crystal_socket.h"
+
+#include <sol/sol.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace crystal
+{
+struct SnapshotEntry
+{
+    uint8_t ownedMask{ 0 };
+    uint8_t activeBranch{ 0 };
+};
+
+struct CatalogEntryData
+{
+    uint8_t                  branchId{ 0 };
+    uint8_t                  reqLevel{ 10 };
+    std::string              key;
+    std::string              name;
+    std::string              role;
+    std::string              icon;
+    std::string              description;
+    std::vector<std::string> highlights;
+};
+
+struct CatalogData
+{
+    std::string                   jobName;
+    std::vector<CatalogEntryData> entries;
+};
+
+inline auto sanitizeField(std::string value) -> std::string
+{
+    std::replace(value.begin(), value.end(), '\x1f', ' ');
+    std::replace(value.begin(), value.end(), '\r', ' ');
+    std::replace(value.begin(), value.end(), '\n', ' ');
+    return value;
+}
+
+template <typename Key>
+auto getTableField(const sol::table& tbl, Key&& key) -> std::optional<sol::table>
+{
+    const sol::object obj = tbl.get<sol::object>(std::forward<Key>(key));
+    if (obj.valid() && obj.get_type() == sol::type::table)
+    {
+        return obj.as<sol::table>();
+    }
+    return std::nullopt;
+}
+
+inline auto getProtectedTableResult(const sol::protected_function_result& res) -> std::optional<sol::table>
+{
+    if (!res.valid())
+    {
+        return std::nullopt;
+    }
+
+    const sol::object obj = res.get<sol::object>();
+    if (obj.valid() && obj.get_type() == sol::type::table)
+    {
+        return obj.as<sol::table>();
+    }
+    return std::nullopt;
+}
+
+inline auto getSpecTable(sol::state& luaState) -> std::optional<sol::table>
+{
+    const auto xiTbl = getTableField(luaState.globals(), "xi");
+    if (!xiTbl)
+    {
+        return std::nullopt;
+    }
+
+    const auto overlordsTbl = getTableField(*xiTbl, "overlords");
+    if (!overlordsTbl)
+    {
+        return std::nullopt;
+    }
+
+    return getTableField(*overlordsTbl, "spec");
+}
+
+inline auto getProtectedFunction(const sol::table& tbl, const char* name) -> std::optional<sol::protected_function>
+{
+    const sol::object obj = tbl.get<sol::object>(name);
+    if (obj.valid() && obj.get_type() == sol::type::function)
+    {
+        return obj.as<sol::protected_function>();
+    }
+    return std::nullopt;
+}
+
+inline auto parseCrystalSnapshot(const sol::table& snapshot) -> std::array<SnapshotEntry, MaxJobs>
+{
+    std::array<SnapshotEntry, MaxJobs> result{};
+    const auto jobsTbl = getTableField(snapshot, "jobs");
+    if (!jobsTbl)
+    {
+        return result;
+    }
+
+    for (uint8_t jobId = 1; jobId < MaxJobs; ++jobId)
+    {
+        const auto entryTbl = getTableField(*jobsTbl, static_cast<int>(jobId));
+        if (!entryTbl)
+        {
+            continue;
+        }
+
+        const uint8_t ownedMask    = entryTbl->get_or<uint8_t>("ownedMask", 0);
+        const uint8_t activeBranch = entryTbl->get_or<uint8_t>("activeBranch", 0);
+
+        result[jobId].ownedMask    = ownedMask & 0xFE;
+        result[jobId].activeBranch = activeBranch <= MaxBranches ? activeBranch : 0;
+    }
+
+    return result;
+}
+
+inline auto parseCrystalCatalog(const sol::table& catalog) -> CatalogData
+{
+    CatalogData out{};
+    out.jobName = sanitizeField(catalog.get_or<std::string>("jobName", ""));
+
+    const auto entriesTbl = getTableField(catalog, "entries");
+    if (!entriesTbl)
+    {
+        return out;
+    }
+
+    const size_t entryCount = std::min<size_t>(entriesTbl->size(), MaxBranches);
+    out.entries.reserve(entryCount);
+
+    for (size_t i = 1; i <= entryCount; ++i)
+    {
+        const auto entryTbl = getTableField(*entriesTbl, i);
+        if (!entryTbl)
+        {
+            continue;
+        }
+
+        CatalogEntryData item{};
+        item.branchId    = entryTbl->get_or<uint8_t>("id", 0);
+        item.reqLevel    = entryTbl->get_or<uint8_t>("reqLevel", 10);
+        item.key         = sanitizeField(entryTbl->get_or<std::string>("key", ""));
+        item.name        = sanitizeField(entryTbl->get_or<std::string>("name", ""));
+        item.role        = sanitizeField(entryTbl->get_or<std::string>("role", ""));
+        item.icon        = sanitizeField(entryTbl->get_or<std::string>("icon", ""));
+        item.description = sanitizeField(entryTbl->get_or<std::string>("description", ""));
+
+        if (const auto highlightsTbl = getTableField(*entryTbl, "highlights"))
+        {
+            const size_t hlCount = std::min<size_t>(highlightsTbl->size(), 255);
+            item.highlights.reserve(hlCount);
+            for (size_t h = 1; h <= hlCount; ++h)
+            {
+                const sol::object hlObj = highlightsTbl->get<sol::object>(h);
+                if (hlObj.valid() && hlObj.is<std::string>())
+                {
+                    item.highlights.push_back(sanitizeField(hlObj.as<std::string>()));
+                }
+            }
+        }
+
+        out.entries.push_back(std::move(item));
+    }
+
+    return out;
+}
+} // namespace crystal
