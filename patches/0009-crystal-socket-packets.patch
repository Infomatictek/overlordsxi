+
+#pragma once
+
+#include <cstdint>
+
+namespace crystal
+{
+constexpr uint32_t Magic        = 0x53595243; // "CRYS"
+constexpr uint32_t CatalogMagic = 0x43595243; // "CRYC"
+constexpr uint8_t  MaxBranches  = 7;
+constexpr uint8_t  MaxJobs      = 24;
+
+enum class Operation : uint8_t
+{
+    Query       = 0,
+    Select      = 1,
+    SyncCatalog = 2,
+};
+
+enum class CatalogKind : uint8_t
+{
+    BeginJob  = 0,
+    Entry     = 1,
+    Highlight = 2,
+    EndJob    = 3,
+};
+
+enum class Result : uint8_t
+{
+    Success  = 0,
+    Locked   = 1,
+    WrongJob = 2,
+    Busy     = 3,
+    Invalid  = 4,
+};
+
+constexpr auto validRequest(uint32_t magic, uint8_t version, uint8_t op, uint16_t reserved) -> bool
+{
+    return magic == Magic && version == 1 && op <= 2 && reserved == 0;
+}
+
+constexpr auto selectionResult(uint8_t mainJob, uint8_t job, uint8_t branch, uint8_t owned, bool busy, uint8_t registeredMask) -> Result
+{
+    if (job == 0 || job >= MaxJobs || branch > MaxBranches || registeredMask == 0)
+    {
+        return Result::Invalid;
+    }
+    if (branch != 0 && !(registeredMask & (1 << branch)))
+    {
+        return Result::Invalid;
+    }
+    if (mainJob != job)
+    {
+        return Result::WrongJob;
+    }
+    if (busy)
+    {
+        return Result::Busy;
+    }
+    if (branch != 0 && !(owned & (1 << branch)))
+    {
+        return Result::Locked;
+    }
+    return Result::Success;
+}
+} // namespace crystal
