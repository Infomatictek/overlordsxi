+void CLuaBaseEntity::restoreAbilityCharge(uint16 recastID, const sol::object& countObj)
+{
+    if (m_PBaseEntity->objtype == TYPE_PC)
+    {
+        auto*       PChar = static_cast<CCharEntity*>(m_PBaseEntity);
+        const uint8 count = countObj.is<uint8>() ? countObj.as<uint8>() : 1;
+
+        PChar->PRecastContainer->RestoreCharge(xi::RecastType::Ability, static_cast<xi::Recast>(recastID), count);
+        PChar->pushPacket<GP_SERV_COMMAND_ABIL_RECAST>(PChar);
+    }
+}
