+/************************************************************************
+ *  Function: getBlueMagicSlots()
+ *  Purpose : Retrieves all 20 BLU spell slots (0 = empty, >0 = spell ID)
+ *  Example : local slots = player:getBlueMagicSlots()
+ ************************************************************************/
+
+auto CLuaBaseEntity::getBlueMagicSlots() -> sol::table
+{
+    auto slotList = lua.create_table();
+
+    if (m_PBaseEntity->objtype != TYPE_PC)
+    {
+        ShowWarning("Invalid entity type calling getBlueMagicSlots (%s).", m_PBaseEntity->getName());
+        return slotList;
+    }
+
+    auto* PChar = static_cast<CCharEntity*>(m_PBaseEntity);
+
+    for (size_t i = 0; i < 20; ++i)
+    {
+        uint8 rawId = PChar->m_SetBlueSpells[i];
+        slotList[i + 1] = rawId != 0 ? static_cast<uint16>(rawId + 0x200) : 0;
+    }
+
+    return slotList;
+}
+
+/************************************************************************
+ *  Function: setBlueMagicSpell()
+ *  Purpose : Sets or clears a Blue Magic spell in slotIndex (0..19)
+ *  Example : player:setBlueMagicSpell(0, xi.magic.spell.POLLEN, true)
+ ************************************************************************/
+
+void CLuaBaseEntity::setBlueMagicSpell(uint8 slotIndex, uint16 spellID, const sol::optional<bool>& sendUpdate)
+{
+    if (m_PBaseEntity->objtype != TYPE_PC)
+    {
+        ShowWarning("Invalid entity type calling setBlueMagicSpell (%s).", m_PBaseEntity->getName());
+        return;
+    }
+
+    if (slotIndex >= 20)
+    {
+        ShowWarning("setBlueMagicSpell: slotIndex %u out of range (%s).", slotIndex, m_PBaseEntity->getName());
+        return;
+    }
+
+    auto* PChar = static_cast<CCharEntity*>(m_PBaseEntity);
+
+    if (spellID == 0)
+    {
+        if (PChar->m_SetBlueSpells[slotIndex] != 0)
+        {
+            if (auto* POldSpell = dynamic_cast<CBlueSpell*>(spell::GetSpell(static_cast<SpellID>(PChar->m_SetBlueSpells[slotIndex] + 0x200))))
+            {
+                blueutils::SetBlueSpell(PChar, POldSpell, slotIndex, false);
+            }
+        }
+    }
+    else if (auto* PSpell = dynamic_cast<CBlueSpell*>(spell::GetSpell(static_cast<SpellID>(spellID))))
+    {
+        blueutils::SetBlueSpell(PChar, PSpell, slotIndex, true);
+    }
+
+    if (sendUpdate.value_or(true))
+    {
+        syncBlueMagicSpells();
+    }
+}
+
+/************************************************************************
+ *  Function: syncBlueMagicSpells()
+ *  Purpose : Rebuilds traits/stats and pushes BLU 0x044/status packets
+ ************************************************************************/
+
+void CLuaBaseEntity::syncBlueMagicSpells()
+{
+    if (m_PBaseEntity->objtype != TYPE_PC)
+    {
+        ShowWarning("Invalid entity type calling syncBlueMagicSpells (%s).", m_PBaseEntity->getName());
+        return;
+    }
+
+    auto* PChar = static_cast<CCharEntity*>(m_PBaseEntity);
+
+    charutils::BuildingCharTraitsTable(PChar);
+    PChar->pushPacket<GP_SERV_COMMAND_COMMAND_DATA>(PChar);
+    charutils::SendExtendedJobPackets(PChar);
+    PChar->pushPacket<GP_SERV_COMMAND_CLISTATUS>(PChar);
+    charutils::CalculateStats(PChar);
+    PChar->UpdateHealth();
+}
+
