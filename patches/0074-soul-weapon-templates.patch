+auto CLuaBaseEntity::getWeaponLook() -> std::tuple<uint16, uint16>
+{
+    if (m_PBaseEntity->objtype == TYPE_PC)
+    {
+        const auto* PChar = static_cast<const CCharEntity*>(m_PBaseEntity);
+        return { PChar->look.main, PChar->look.sub };
+    }
+    return { 0, 0 };
+}
