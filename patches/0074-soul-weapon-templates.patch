+auto GetSoulWeaponCombatProfile(CCharEntity* PChar) -> SoulWeaponCombatProfile
+{
+    SoulWeaponCombatProfile profile{};
+    if (PChar == nullptr || PChar->GetLocalVar("OX_WEAPON_CFG_ACTIVE") == 0)
+    {
+        return profile;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.weaponConfig.getCombatProfile");
+    if (!func.valid())
+    {
+        return profile;
+    }
+
+    const auto result = func(PChar);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::GetSoulWeaponCombatProfile: %s", err.what());
+        return profile;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (!retObj.valid() || !retObj.is<sol::table>())
+    {
+        return profile;
+    }
+
+    const sol::table tbl      = retObj.as<sol::table>();
+    profile.active            = tbl.get_or("active", false);
+    profile.mainDamageScale   = tbl.get_or("mainDamageScale", 1.0f);
+    profile.subDamageScale    = tbl.get_or("subDamageScale", 1.0f);
+    profile.delayScale        = tbl.get_or("delayScale", 1.0f);
+    profile.tpScale           = tbl.get_or("tpScale", 1.0f);
+    profile.subMultiAttackOff = tbl.get_or("subMultiAttackOff", false);
+    return profile;
+}
+
+auto GetSoulWeaponVisualModels(CCharEntity* PChar, uint16& mainModel, uint16& subModel) -> bool
+{
+    mainModel = 0;
+    subModel  = 0;
+    if (PChar == nullptr)
+    {
+        return false;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.weaponConfig.getVisualModels");
+    if (!func.valid())
+    {
+        return false;
+    }
+
+    const auto result = func(PChar);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::GetSoulWeaponVisualModels: %s", err.what());
+        return false;
+    }
+
+    if (result.return_count() >= 2)
+    {
+        const sol::object mObj = result.get<sol::object>(0);
+        const sol::object sObj = result.get<sol::object>(1);
+        if (mObj.valid() && mObj.is<uint16>() && sObj.valid() && sObj.is<uint16>())
+        {
+            mainModel = mObj.as<uint16>();
+            subModel  = sObj.as<uint16>();
+            return mainModel != 0 && subModel != 0;
+        }
+    }
+
+    return false;
+}
+
 }; // namespace luautils
