new file mode 100644
--- /dev/null
+++ b/src/map/utils/arcane_archer_actions.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+
+namespace arcaneArcher
+{
+inline constexpr uint16 AttunementArrow = 57;
+inline constexpr uint16 NextElement = 59;
+inline constexpr uint16 PreviousElement = 58;
+inline constexpr uint16 ArrowRecast = 122;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::RNG && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_ACA_ACTIVE") == 1;
+}
+
+inline auto usesBow(const CItemWeapon* weapon, const CItemWeapon* ammo) -> bool
+{
+    return weapon && ammo && ammo->getQuantity() > 0 &&
+           weapon->getSkillType() == xi::SkillType::Archery && ammo->getSkillType() == xi::SkillType::Archery;
+}
+} // namespace arcaneArcher
