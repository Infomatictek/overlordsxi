diff --git a/src/map/utils/channeler_actions.h b/src/map/utils/channeler_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/channeler_actions.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "common/timer.h"
+#include "entities/char_entity.h"
+#include "spell.h"
+#include "utils/zoneutils.h"
+
+namespace channeler
+{
+inline constexpr uint16 ConduitLink = 273;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::BLM && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_CHN_ACTIVE") == 1;
+}
+
+inline auto nowSecond() -> uint32
+{
+    return static_cast<uint32>(std::chrono::duration_cast<std::chrono::seconds>(timer::now().time_since_epoch()).count());
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    if (id == SpellID::Thunder)
+    {
+        return 10;
+    }
+    return id == SpellID::Aspir ? 30 : 0;
+}
+
+inline auto playerById(uint32 id) -> CCharEntity*
+{
+    return id == 0 ? nullptr : dynamic_cast<CCharEntity*>(zoneutils::GetEntity(id, TYPE_PC));
+}
+
+inline auto linkOwner(const CCharEntity* recipient) -> CCharEntity*
+{
+    auto* owner = playerById(recipient->GetLocalVar("OX_CHN_OWNER"));
+    if (!isActive(owner) || !owner->isAlive() || !recipient->isAlive() || owner->loc.zone != recipient->loc.zone ||
+        owner->GetLocalVar("OX_CHN_RECIPIENT") != recipient->id)
+    {
+        return nullptr;
+    }
+    const bool reserved = recipient->GetLocalVar("OX_CHN_RESERVED") > nowSecond();
+    if (owner != recipient && (isActive(recipient) || !owner->PParty || owner->PParty != recipient->PParty ||
+                              (!reserved && distance(owner->loc.p, recipient->loc.p) > recipient->GetLocalVar("OX_CHN_RANGE"))))
+    {
+        return nullptr;
+    }
+    return owner;
+}
+
+inline auto isHolding(const CCharEntity* owner) -> bool
+{
+    const auto* recipient = playerById(owner->GetLocalVar("OX_CHN_RECIPIENT"));
+    const auto now = nowSecond();
+    return recipient && recipient != owner && linkOwner(recipient) == owner &&
+           (recipient->GetLocalVar("OX_CHN_LINK_UNTIL") > now || recipient->GetLocalVar("OX_CHN_RESERVED") > now);
+}
+
+inline auto discountedCost(uint16 cost, uint8 percent) -> uint16
+{
+    return cost == 0 ? 0 : static_cast<uint16>(std::max<int32>(1, cost * (100 - percent) / 100));
+}
+} // namespace channeler
