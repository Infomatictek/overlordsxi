diff --git a/src/map/utils/beastspeaker_actions.h b/src/map/utils/beastspeaker_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/beastspeaker_actions.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include "ability.h"
+#include "entities/battle_entity.h"
+
+namespace beastspeaker
+{
+inline auto isActive(const CBattleEntity* entity) -> bool
+{
+    return entity && entity->objtype == TYPE_PC && entity->GetMJob() == xi::Job::BST &&
+           entity->GetMLevel() >= 10 && entity->GetLocalVar("OX_BSP_ACTIVE") == 1;
+}
+
+inline auto kitAbility(uint16 id, uint8 level) -> bool
+{
+    switch (id)
+    {
+        case ABILITY_GAUGE:
+        case ABILITY_TAME:
+        case ABILITY_FIGHT:
+        case ABILITY_HEEL:
+        case ABILITY_LEAVE:
+        case ABILITY_CALL_BEAST:
+            return true;
+        case ABILITY_STAY:
+            return level >= 50;
+        default:
+            return false;
+    }
+}
+} // namespace beastspeaker
