@@ -6370,6 +6371,33 @@ auto GetItemIDByName(const std::string& name) -> uint16
 
 auto GenerateDynamicEntity(CZone* PZone, CInstance* PInstance, sol::table table) -> CBaseEntity*
 {
+    // A player look is not a model ID or a Lua-reconstructed byte string. Resolve
+    // the authoritative source before allocating/assigning a dynamic entity ID so
+    // an invalid source fails without leaking a target slot.
+    CCharEntity* PLookSource = nullptr;
+    if (const sol::object lookSourceObj = table.get<sol::object>("lookSource"); lookSourceObj.valid())
+    {
+        if (!lookSourceObj.is<CLuaBaseEntity*>())
+        {
+            ShowWarning("luautils::GenerateDynamicEntity: lookSource is not an entity.");
+            return nullptr;
+        }
+
+        auto* PLuaLookSource = lookSourceObj.as<CLuaBaseEntity*>();
+        PLookSource          = PLuaLookSource ? dynamic_cast<CCharEntity*>(PLuaLookSource->GetBaseEntity()) : nullptr;
+        if (PLookSource == nullptr)
+        {
+            ShowWarning("luautils::GenerateDynamicEntity: lookSource is not a player.");
+            return nullptr;
+        }
+
+        if (PLookSource->loc.zone != PZone || PLookSource->PInstance != PInstance)
+        {
+            ShowWarning("luautils::GenerateDynamicEntity: lookSource player is not in the destination zone/instance.");
+            return nullptr;
+        }
+    }
+
     CBaseEntity* PEntity = nullptr;
     if (table.get_or<uint8>("objtype", TYPE_NPC) == TYPE_NPC)
     {
@@ -6441,8 +6469,22 @@ auto GenerateDynamicEntity(CZone* PZone, CInstance* PInstance, sol::table table)
     }
 
     // Look must be set _before_ inserting the entity into the zone,
-    // else equipped NPCs/Mobs will be invisible.
-    if (table["look"].get_type() == sol::type::number)
+    // else equipped NPCs/Mobs will be invisible.  A PC stores physical size in
+    // look.size, while an equipped MOB must store MODEL_EQUIPPED there; copy
+    // the visible fields individually through look_t and transfer size to the
+    // entity packet's modelSize field.
+    if (PLookSource != nullptr)
+    {
+        const auto& visibleLook = PLookSource->getStyleLocked() ? PLookSource->mainlook : PLookSource->look;
+        PEntity->look           = visibleLook;
+        PEntity->look.size      = MODEL_EQUIPPED;
+        PEntity->modelSize      = static_cast<uint8>(std::min<uint16>(PLookSource->look.size, 3));
+        if (PLookSource->playerConfig.DisplayHeadOffFlg)
+        {
+            PEntity->look.head = 0;
+        }
+    }
+    else if (table["look"].get_type() == sol::type::number)
     {
         PEntity->SetModelId(table.get<uint16>("look"));
     }
