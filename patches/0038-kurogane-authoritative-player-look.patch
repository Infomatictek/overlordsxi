+/************************************************************************
+ *  Function: getLookSnapshot()
+ *  Purpose : Returns the authoritative currently visible equipped look.
+ *  Example : local look = player:getLookSnapshot()
+ *  Notes   : Includes all eight equipment slots and maps PC size to the
+ *            dynamic-entity modelSize representation used by update packets.
+ ************************************************************************/
+auto CLuaBaseEntity::getLookSnapshot() -> sol::table
+{
+    auto table = lua.create_table();
+
+    const look_t* PLook     = &m_PBaseEntity->look;
+    uint8         modelSize = m_PBaseEntity->modelSize;
+    bool          hideHead  = false;
+
+    if (auto* PChar = dynamic_cast<CCharEntity*>(m_PBaseEntity))
+    {
+        PLook     = PChar->getStyleLocked() ? &PChar->mainlook : &PChar->look;
+        modelSize = static_cast<uint8>(std::min<uint16>(PChar->look.size, 3));
+        hideHead  = PChar->playerConfig.DisplayHeadOffFlg;
+    }
+
+    table["lookType"]  = PLook->size;
+    table["modelSize"] = modelSize;
+    table["face"]      = PLook->face;
+    table["race"]      = PLook->race;
+    table["head"]      = hideHead ? 0 : PLook->head;
+    table["body"]      = PLook->body;
+    table["hands"]     = PLook->hands;
+    table["legs"]      = PLook->legs;
+    table["feet"]      = PLook->feet;
+    table["main"]      = PLook->main;
+    table["sub"]       = PLook->sub;
+    table["ranged"]    = PLook->ranged;
+
+    return table;
+}
