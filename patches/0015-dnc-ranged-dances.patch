+void HandleRangedSamba(CBattleEntity* PAttacker, CBattleEntity* PDefender, action_result_t* Action, uint16 delay, int32 finaldamage)
+{
+    if (PAttacker == nullptr || PDefender == nullptr || Action == nullptr || PDefender->GetHPP() == 0 || finaldamage <= 0)
+    {
+        return;
+    }
+
+    auto* PChar = dynamic_cast<CCharEntity*>(PAttacker);
+
+    // 1. If attacker is a Bladewheel DNC with a Samba active, apply/refresh Daze on the target for the party.
+    if (PChar != nullptr && PChar->GetLocalVar("OX_DNC_RANGED") == 1)
+    {
+        xi::StatusEffect applyDaze      = xi::StatusEffect::None;
+        uint16           applyDazePower = 0;
+
+        if (PAttacker->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::DrainSamba) && PDefender->m_EcoSystem != xi::Ecosystem::Undead)
+        {
+            applyDaze      = xi::StatusEffect::DrainDaze;
+            applyDazePower = PAttacker->StatusEffectContainer->GetStatusEffect(xi::StatusEffect::DrainSamba)->GetPower();
+        }
+        else if (PAttacker->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::AspirSamba))
+        {
+            applyDaze      = xi::StatusEffect::AspirDaze;
+            applyDazePower = PAttacker->StatusEffectContainer->GetStatusEffect(xi::StatusEffect::AspirSamba)->GetPower();
+        }
+        else if (PAttacker->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::HasteSamba))
+        {
+            applyDaze      = xi::StatusEffect::HasteDaze;
+            applyDazePower = PAttacker->StatusEffectContainer->GetStatusEffect(xi::StatusEffect::HasteSamba)->GetPower();
+        }
+
+        if (applyDaze != xi::StatusEffect::None && applyDazePower > 0)
+        {
+            if (PAttacker->PParty != nullptr)
+            {
+                for (auto* PMember : PAttacker->PParty->members)
+                {
+                    PDefender->StatusEffectContainer->DelStatusEffect(xi::StatusEffect::DrainDaze, PMember->id);
+                    PDefender->StatusEffectContainer->DelStatusEffect(xi::StatusEffect::HasteDaze, PMember->id);
+                    PDefender->StatusEffectContainer->DelStatusEffect(xi::StatusEffect::AspirDaze, PMember->id);
+                }
+            }
+            else
+            {
+                PDefender->StatusEffectContainer->DelStatusEffect(xi::StatusEffect::DrainDaze, PAttacker->id);
+                PDefender->StatusEffectContainer->DelStatusEffect(xi::StatusEffect::HasteDaze, PAttacker->id);
+                PDefender->StatusEffectContainer->DelStatusEffect(xi::StatusEffect::AspirDaze, PAttacker->id);
+            }
+            PDefender->StatusEffectContainer->AddStatusEffectSilent(applyDaze, 0, applyDazePower, 0s, 10s, PAttacker->id);
+        }
+    }
+
+    // 2. Proc active Daze on the target if applied by the attacker or a party member.
+    const bool hasDrainDaze = PDefender->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::DrainDaze);
+    const bool hasAspirDaze = PDefender->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::AspirDaze);
+    const bool hasHasteDaze = PDefender->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::HasteDaze);
+
+    if (!hasDrainDaze && !hasAspirDaze && !hasHasteDaze)
+    {
+        return;
+    }
+
+    xi::StatusEffect daze = xi::StatusEffect::None;
+    if (hasDrainDaze)
+    {
+        daze = xi::StatusEffect::DrainDaze;
+    }
+    else if (hasAspirDaze)
+    {
+        daze = xi::StatusEffect::AspirDaze;
+    }
+    else if (hasHasteDaze)
+    {
+        daze = xi::StatusEffect::HasteDaze;
+    }
+
+    auto* dazeEffect = PDefender->StatusEffectContainer->GetStatusEffect(daze);
+    if (dazeEffect == nullptr)
+    {
+        return;
+    }
+
+    const uint32 dazeOwnerID = dazeEffect->GetSubID();
+    uint16       dazePower   = 0;
+
+    if (dazeOwnerID == PAttacker->id)
+    {
+        dazePower = dazeEffect->GetPower();
+    }
+    else if (PChar != nullptr && PChar->PParty != nullptr)
+    {
+        PChar->ForPartyWithTrusts([&](CBattleEntity* PMember)
+        {
+            if (dazeOwnerID == PMember->id)
+            {
+                dazePower = dazeEffect->GetPower();
+            }
+        });
+    }
+
+    if (dazePower == 0)
+    {
+        return;
+    }
+
+    const int32 amMult      = (PChar != nullptr && PChar->GetLocalVar("OX_CHAKRAM_AM") > 0) ? 2 : 1;
+    const int32 scaledDelay = std::max<int32>(180, delay / 10);
+
+    if (daze == xi::StatusEffect::DrainDaze)
+    {
+        const uint16 multiplier = static_cast<uint16>(3 + 5.5f * (dazePower - 1));
+        int32        samba      = xirand::GetRandomNumber(1, (scaledDelay * multiplier) / 100 + 1) * amMult;
+        int8         lvlDiff    = PDefender->GetMLevel() - PAttacker->GetMLevel();
+        if (lvlDiff > 0)
+        {
+            lvlDiff = std::min<int8>(lvlDiff, 10);
+            samba -= static_cast<int32>(std::ceil(samba * lvlDiff * 0.04f));
+        }
+        if (finaldamage <= 2 || samba < 0)
+        {
+            samba = 0;
+        }
+        else if (samba > (finaldamage / 2))
+        {
+            samba = finaldamage / 2;
+        }
+        Action->additionalEffect = ActionProcAddEffect::HPDrain;
+        Action->addEffectMessage = MsgBasic::AddEffectHPDrained;
+        Action->addEffectParam   = samba;
+        PAttacker->addHP(samba);
+        if (PChar != nullptr)
+        {
+            PChar->updatemask |= UPDATE_HP;
+        }
+    }
+    else if (daze == xi::StatusEffect::AspirDaze && PDefender->GetMaxMP() > 0)
+    {
+        const uint16 multiplier = 1 + 2 * (dazePower - 1);
+        int32        samba      = xirand::GetRandomNumber(1, (scaledDelay * multiplier) / 100 + 1) * amMult;
+        if (finaldamage <= 2 || samba < 0)
+        {
+            samba = 0;
+        }
+        else if (samba >= finaldamage / 4)
+        {
+            samba = finaldamage / 4;
+        }
+        Action->additionalEffect = ActionProcAddEffect::MPDrain;
+        Action->addEffectMessage = MsgBasic::AddEffectMPDrained;
+        const int16 mpDrained    = PDefender->addMP(-samba);
+        PAttacker->addMP(mpDrained);
+        Action->addEffectParam = mpDrained;
+        if (PChar != nullptr)
+        {
+            PChar->updatemask |= UPDATE_HP;
+        }
+    }
+    else if (daze == xi::StatusEffect::HasteDaze)
+    {
+        Action->additionalEffect = ActionProcAddEffect::Haste;
+        PAttacker->StatusEffectContainer->AddStatusEffect(xi::StatusEffect::HasteSambaHaste, 0, dazePower, 0s, 10s);
+    }
+}
