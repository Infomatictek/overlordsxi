diff --git a/src/map/utils/scarlet_weaver_actions.h b/src/map/utils/scarlet_weaver_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/scarlet_weaver_actions.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include "common/timer.h"
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+#include "spell.h"
+
+namespace scarlet
+{
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::RDM && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_SCW_ACTIVE") == 1;
+}
+
+inline auto isKitAbility(uint16 id) -> bool
+{
+    return id == 247 || id == 274;
+}
+
+struct SpellProfile
+{
+    uint8 level;
+    uint8 recast;
+};
+
+inline auto spellProfile(SpellID id) -> SpellProfile
+{
+    switch (id)
+    {
+        case SpellID::Fire:
+        case SpellID::Blizzard:
+        case SpellID::Aero:
+        case SpellID::Stone:
+        case SpellID::Thunder:
+        case SpellID::Water:
+            return { 10, 3 };
+        case SpellID::Fire_II:    return { 30, 6 };
+        case SpellID::Thunder_II: return { 50, 7 };
+        case SpellID::Aero_III:   return { 70, 12 };
+        default: return {};
+    }
+}
+
+inline auto yangBonus(const CCharEntity* character) -> uint32
+{
+    if (!isActive(character) || character->GetLocalVar("OX_SCW_ASPECT") != 2)
+    {
+        return 0;
+    }
+    const auto now = std::chrono::duration_cast<std::chrono::seconds>(timer::now().time_since_epoch()).count();
+    if (character->GetLocalVar("OX_SCW_RECOVERY_UNTIL") > now)
+    {
+        return 0;
+    }
+    const auto* weapon = dynamic_cast<const CItemWeapon*>(character->m_Weapons[SLOT_MAIN]);
+    return weapon && weapon->getSkillType() == xi::SkillType::Sword ? character->GetLocalVar("OX_SCW_POTENCY") : 0;
+}
+} // namespace scarlet
