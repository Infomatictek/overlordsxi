diff --git a/src/map/utils/diviner_actions.h b/src/map/utils/diviner_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/diviner_actions.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "ability.h"
+#include "entities/char_entity.h"
+#include "spell.h"
+
+namespace diviner
+{
+inline auto isActive(const CCharEntity* entity) -> bool
+{
+    return entity && entity->GetMJob() == xi::Job::GEO && entity->GetMLevel() >= 10 &&
+           entity->GetLocalVar("OX_DIV_ACTIVE") == 1;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    return id == SpellID::Stone || id == SpellID::Indi_Precision ? 10 : 0;
+}
+
+inline auto kitAbility(uint16 id, uint8 level) -> bool
+{
+    return id == ABILITY_FULL_CIRCLE || (id == ABILITY_ECLIPTIC_ATTRITION && level >= 30);
+}
+} // namespace diviner
