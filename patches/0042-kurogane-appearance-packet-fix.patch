+#include "map/entities/mob_entity.h"
+#include "map/packets/entity_update.h"
+
+#include <catch2/catch_test_macros.hpp>
+#include <cstring>
+#include <memory>
+#include <string>
+
+namespace
+{
+
+auto makeRenamedEquippedClone(const std::string& displayName) -> std::unique_ptr<CMobEntity>
+{
+    auto mob            = std::make_unique<CMobEntity>();
+    mob->id             = 0x01067701;
+    mob->targid         = 0x0701;
+    mob->objtype        = TYPE_MOB;
+    mob->allegiance     = xi::Allegiance::Player;
+    mob->name           = "KRG_1_1";
+    mob->packetName     = displayName;
+    mob->isRenamed      = true;
+    mob->modelSize      = 1;
+    mob->look.size      = MODEL_EQUIPPED;
+    mob->look.face      = 0x05;
+    mob->look.race      = 0x02;
+    mob->look.head      = 0x1101;
+    mob->look.body      = 0x2076;
+    mob->look.hands     = 0x3048;
+    mob->look.legs      = 0x4052;
+    mob->look.feet      = 0x5031;
+    mob->look.main      = 0x60B7;
+    mob->look.sub       = 0x70C4;
+    mob->look.ranged    = 0x8019;
+    mob->health.maxhp   = 1;
+    mob->health.hp      = 1;
+    return mob;
+}
+
+auto readPacketNameAt(const CEntityUpdatePacket& pkt, const std::size_t offset, const std::size_t maxLen) -> std::string
+{
+    std::string out;
+    for (std::size_t i = 0; i < maxLen; ++i)
+    {
+        const uint8 ch = pkt.ref<uint8>(offset + i);
+        if (ch == 0)
+        {
+            break;
+        }
+        out.push_back(static_cast<char>(ch));
+    }
+    return out;
+}
+
+void checkEquippedClonePacket(const CEntityUpdatePacket& pkt, const std::string& expectedName, const uint16 expectedHead)
+{
+    const uint8 flags = pkt.ref<uint8>(0x0A);
+    CHECK((flags & UPDATE_LOOK) != 0);
+    CHECK((flags & 0x40) != 0); // Name2
+    CHECK((flags & UPDATE_NAME) == 0);
+
+    CHECK(pkt.ref<uint16>(0x30) == MODEL_EQUIPPED);
+    CHECK(pkt.ref<uint8>(0x32) == 0x05);
+    CHECK(pkt.ref<uint8>(0x33) == 0x02);
+    CHECK(pkt.ref<uint16>(0x34) == expectedHead);
+    CHECK(pkt.ref<uint16>(0x36) == 0x2076);
+    CHECK(pkt.ref<uint16>(0x38) == 0x3048);
+    CHECK(pkt.ref<uint16>(0x3A) == 0x4052);
+    CHECK(pkt.ref<uint16>(0x3C) == 0x5031);
+    CHECK(pkt.ref<uint16>(0x3E) == 0x60B7);
+    CHECK(pkt.ref<uint16>(0x40) == 0x70C4);
+    CHECK(pkt.ref<uint16>(0x42) == 0x8019);
+    CHECK(readPacketNameAt(pkt, 0x44, 18) == expectedName);
+}
+
+} // namespace
+
+TEST_CASE("Kurogane 0x00E packet preserves encoded equipment and name without overlap", "[kurogane][packets]")
+{
+    const std::string displayName = "Rin's Shadow";
+    auto              mob         = makeRenamedEquippedClone(displayName);
+
+    SECTION("initial ENTITY_SPAWN encodes all eight slots and writes packetName at 0x44")
+    {
+        CEntityUpdatePacket pkt(mob.get(), ENTITY_SPAWN, UPDATE_ALL_MOB);
+        CHECK(pkt.getSize() == 0x58);
+        CHECK(pkt.ref<uint8>(0x0A) == 0x57);
+        checkEquippedClonePacket(pkt, displayName, 0x1101);
+    }
+
+    SECTION("coalesced ENTITY_UPDATE into pending ENTITY_SPAWN preserves equipment bytes")
+    {
+        CEntityUpdatePacket pkt(mob.get(), ENTITY_SPAWN, UPDATE_ALL_MOB);
+        pkt.updateWith(mob.get(), ENTITY_UPDATE, UPDATE_HP | UPDATE_POS);
+        CHECK(pkt.getSize() == 0x58);
+        checkEquippedClonePacket(pkt, displayName, 0x1101);
+    }
+
+    SECTION("standalone subsequent ENTITY_UPDATE never writes packetName over 0x34..0x43")
+    {
+        CEntityUpdatePacket pkt(mob.get(), ENTITY_UPDATE, UPDATE_ALL_MOB);
+        CHECK(pkt.getSize() == 0x58);
+        checkEquippedClonePacket(pkt, displayName, 0x1101);
+    }
+
+    SECTION("hidden head (0x0000) is preserved at 0x34 across spawn and update")
+    {
+        mob->look.head = 0x0000;
+        CEntityUpdatePacket pkt(mob.get(), ENTITY_SPAWN, UPDATE_ALL_MOB);
+        checkEquippedClonePacket(pkt, displayName, 0x0000);
+        pkt.updateWith(mob.get(), ENTITY_UPDATE, UPDATE_HP);
+        checkEquippedClonePacket(pkt, displayName, 0x0000);
+    }
+
+    SECTION("ENTITY_DESPAWN keeps despawn flags without overwriting 0x34 with packetName")
+    {
+        CEntityUpdatePacket pkt(mob.get(), ENTITY_DESPAWN, UPDATE_ALL_MOB);
+        CHECK(pkt.ref<uint8>(0x0A) == 0x30);
+        CHECK(pkt.ref<uint16>(0x36) == 0x2076);
+    }
+}
