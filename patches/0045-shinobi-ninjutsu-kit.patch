+auto isShinobiSpec(CBattleEntity* PEntity) -> bool
+{
+    auto* PChar = dynamic_cast<CCharEntity*>(PEntity);
+    return PChar != nullptr && PChar->GetMJob() == xi::Job::NIN && PChar->GetMLevel() >= 10 && PChar->GetLocalVar("OX_SHINOBI_ACTIVE") == 1;
+}
+
+auto isShinobiKitSpell(const SpellID spellId) -> bool
+{
+    switch (spellId)
+    {
+        case SpellID::Katon_Ichi:
+        case SpellID::Hyoton_Ichi:
+        case SpellID::Huton_Ichi:
+        case SpellID::Doton_Ichi:
+        case SpellID::Raiton_Ichi:
+        case SpellID::Suiton_Ichi:
+        case SpellID::Utsusemi_Ichi:
+        case SpellID::Utsusemi_Ni:
+            return true;
+        default:
+            return false;
+    }
+}
+
