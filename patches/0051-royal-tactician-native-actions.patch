diff --git a/src/map/utils/royal_tactician_actions.h b/src/map/utils/royal_tactician_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/royal_tactician_actions.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include "common/timer.h"
+#include "entities/char_entity.h"
+#include "spell.h"
+#include "utils/zoneutils.h"
+
+namespace royal
+{
+inline constexpr uint16 IssueOrder = 275;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::RDM && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_RYT_ACTIVE") == 1;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    switch (id)
+    {
+        case SpellID::Slow:
+        case SpellID::Paralyze:
+        case SpellID::Blind:
+        case SpellID::Silence: return 10;
+        case SpellID::Dispel: return 30;
+        default: return 0;
+    }
+}
+
+inline auto recomposePercent(CCharEntity* caster) -> int32
+{
+    const auto now = std::chrono::duration_cast<std::chrono::seconds>(timer::now().time_since_epoch()).count();
+    if (!caster || caster->GetLocalVar("OX_RYT_ORDER_KIND") != 2 || caster->GetLocalVar("OX_RYT_ORDER_UNTIL") <= now)
+    {
+        return 0;
+    }
+    const auto* owner = dynamic_cast<const CCharEntity*>(zoneutils::GetEntity(caster->GetLocalVar("OX_RYT_OWNER"), TYPE_PC));
+    if (!isActive(owner) || !owner->isAlive() || owner->loc.zone != caster->loc.zone ||
+        owner->GetLocalVar("OX_RYT_RECIPIENT") != caster->id ||
+        (caster != owner && (!caster->PParty || caster->PParty != owner->PParty)))
+    {
+        return 0;
+    }
+
+    caster->SetLocalVar("OX_RYT_ORDER_KIND", 0);
+    caster->SetLocalVar("OX_RYT_ORDER_UNTIL", 0);
+    return caster->GetLocalVar("OX_RYT_ORDER_PCT");
+}
+} // namespace royal
