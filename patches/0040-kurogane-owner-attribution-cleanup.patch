+/************************************************************************
+ *  Function: attributeDamageTo()
+ *  Purpose : Attributes damage already dealt by an ownerless allied entity.
+ *  Example : target:attributeDamageTo(player, damage)
+ *  Notes   : Does not apply HP damage or fire TAKE_DAMAGE a second time.
+ ************************************************************************/
+auto CLuaBaseEntity::attributeDamageTo(CLuaBaseEntity* PEntity, const int32 damage) -> bool
+{
+    auto* PMob   = dynamic_cast<CMobEntity*>(m_PBaseEntity);
+    auto* POwner = PEntity ? dynamic_cast<CCharEntity*>(PEntity->GetBaseEntity()) : nullptr;
+
+    if (PMob == nullptr || POwner == nullptr || damage <= 0 || !POwner->isAlive() ||
+        PMob->loc.zone != POwner->loc.zone || PMob->PInstance != POwner->PInstance ||
+        PMob->allegiance == POwner->allegiance)
+    {
+        ShowWarning("attributeDamageTo(): invalid target, owner, damage, or battle context.");
+        return false;
+    }
+
+    // Native damage has already changed HP. Transfer every ownership surface
+    // without replaying damage or its listeners: final attacker, reward claim,
+    // damage-derived threat, and the owner's Records of Eminence damage event.
+    PMob->lastAttackerId_ = EntityId(POwner);
+    battleutils::ClaimMob(PMob, POwner);
+    PMob->PEnmityContainer->UpdateEnmityFromDamage(POwner, damage);
+    roeutils::event(ROE_EVENT::ROE_DMGDEALT, POwner, RoeDatagram("dmg", damage));
+
+    return true;
+}
