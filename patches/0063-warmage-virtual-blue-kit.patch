  *  Function: syncBlueMagicSpells()
  *  Purpose : Rebuilds traits/stats and pushes BLU 0x044/status packets
  ************************************************************************/
+
+void CLuaBaseEntity::setWarmageKit(bool enabled)
+{
+    auto* player = dynamic_cast<CCharEntity*>(m_PBaseEntity);
+    if (!player || (enabled && player->GetMJob() != xi::Job::BLU))
+    {
+        return;
+    }
+
+    const auto wasEnabled = player->GetLocalVar(warmage::Active) == 1;
+    if (wasEnabled != enabled)
+    {
+        for (const auto slot : player->m_SetBlueSpells)
+        {
+            if (slot == 0)
+            {
+                continue;
+            }
+            const auto spellId = static_cast<SpellID>(static_cast<uint16>(slot) + 0x200);
+            if (auto* blue = dynamic_cast<CBlueSpell*>(spell::GetSpell(spellId)))
+            {
+                if (enabled)
+                {
+                    player->delModifiers(&blue->modList);
+                }
+                else if (player->GetMJob() == xi::Job::BLU || player->GetSJob() == xi::Job::BLU)
+                {
+                    player->addModifiers(&blue->modList);
+                }
+            }
+        }
+        player->SetLocalVar(warmage::Active, enabled ? 1 : 0);
+        charutils::BuildingCharTraitsTable(player);
+        charutils::CalculateStats(player);
+        player->UpdateHealth();
+    }
+    charutils::SendExtendedJobPackets(player);
+    player->pushPacket<GP_SERV_COMMAND_CLISTATUS>(player);
+}
 
