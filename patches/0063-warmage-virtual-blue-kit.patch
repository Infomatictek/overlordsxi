diff --git a/src/map/utils/warmage_actions.h b/src/map/utils/warmage_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/warmage_actions.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <array>
+
+#include "entities/char_entity.h"
+#include "spell.h"
+
+namespace warmage
+{
+inline constexpr uint16 Assess = 94;
+inline constexpr const char* Active = "OX_WMG_ACTIVE";
+
+struct SpellProfile
+{
+    SpellID id;
+    uint8 level;
+    uint16 mp;
+    timer::duration cast;
+    timer::duration recast;
+    float range;
+};
+
+inline constexpr std::array Kit{
+    SpellProfile{ SpellID::Sprout_Smack,    10,  6,  500ms,  7s,  5.0f },
+    SpellProfile{ SpellID::Power_Attack,    10,  5,  500ms,  7s,  5.0f },
+    SpellProfile{ SpellID::Foot_Kick,       10,  5,  500ms,  7s,  5.0f },
+    SpellProfile{ SpellID::Bludgeon,        30, 16,  500ms, 12s,  5.0f },
+    SpellProfile{ SpellID::Smite_of_Rage,   30, 24,  500ms, 13s,  5.0f },
+    SpellProfile{ SpellID::Jet_Stream,      50, 28,  500ms, 16s,  8.0f },
+    SpellProfile{ SpellID::Mandibular_Bite, 50, 25,  500ms, 17s,  5.0f },
+    SpellProfile{ SpellID::Bomb_Toss,       50, 26, 1500ms, 16s, 15.0f },
+    SpellProfile{ SpellID::Death_Scissors,  70, 32,  500ms, 20s,  5.0f },
+    SpellProfile{ SpellID::Heat_Breath,     70, 36, 1800ms, 20s, 10.0f },
+    SpellProfile{ SpellID::Mind_Blast,      70, 30, 1400ms, 18s, 15.0f },
+};
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::BLU && character->GetLocalVar(Active) == 1;
+}
+
+inline auto profile(SpellID id) -> const SpellProfile*
+{
+    for (const auto& entry : Kit)
+    {
+        if (entry.id == id)
+        {
+            return &entry;
+        }
+    }
+    return nullptr;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    const auto* entry = profile(id);
+    return entry ? entry->level : 0;
+}
+} // namespace warmage
