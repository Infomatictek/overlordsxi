diff --git a/src/map/utils/scourge_actions.h b/src/map/utils/scourge_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/scourge_actions.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "spell.h"
+
+namespace scourge
+{
+inline constexpr uint16 Rite = 50;
+inline constexpr uint32 PhysicalMove = 1;
+inline constexpr uint32 Spell = 2;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::DRK && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_SCR_ACTIVE") == 1;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    switch (id)
+    {
+        case SpellID::Absorb_STR:
+        case SpellID::Bio:
+            return 10;
+        case SpellID::Absorb_MND:
+            return 30;
+        default:
+            return 0;
+    }
+}
+
+class ObserveAction
+{
+public:
+    ObserveAction(CBattleEntity& mob, uint32 category)
+    : mob_(mob)
+    , active_(mob.objtype == TYPE_MOB && mob.allegiance == xi::Allegiance::Mob)
+    {
+        if (active_)
+        {
+            mob_.SetLocalVar("OX_SCR_ACTION", category);
+        }
+    }
+
+    ~ObserveAction()
+    {
+        if (active_)
+        {
+            mob_.SetLocalVar("OX_SCR_ACTION", 0);
+        }
+    }
+
+private:
+    CBattleEntity& mob_;
+    bool active_;
+};
+} // namespace scourge
