+void OnUtsusemiShadowBroken(CBattleEntity* PDefender, CBattleEntity* PAttacker, uint16 shadowsBroken)
+{
+    if (PDefender == nullptr || shadowsBroken == 0)
+    {
+        return;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.onUtsusemiShadowBroken");
+    if (!func.valid())
+    {
+        return;
+    }
+
+    const auto result = func(PDefender, PAttacker, shadowsBroken);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::OnUtsusemiShadowBroken: %s", err.what());
+    }
+}
+
 }; // namespace luautils
