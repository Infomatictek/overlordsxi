diff --git a/src/map/utils/nightblade_actions.h b/src/map/utils/nightblade_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/nightblade_actions.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "spell.h"
+#include "status_effect_container.h"
+
+namespace nightblade
+{
+inline constexpr uint16 QuickRead = 249;
+inline constexpr uint32 Spell = 1;
+inline constexpr uint32 Technique = 2;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::NIN && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_NGB_ACTIVE") == 1;
+}
+
+inline auto isSeal(SpellID id) -> bool
+{
+    return id == SpellID::Jubaku_Ichi || id == SpellID::Hojo_Ichi;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    return isSeal(id) || id == SpellID::Katon_Ichi ? 10 : 0;
+}
+
+inline auto nowSecond() -> uint32
+{
+    return static_cast<uint32>(std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline auto canDisrupt(CBattleEntity& mob, CSpell& spell) -> bool
+{
+    return spell.getSkillType() != xi::SkillType::Singing && mob.getMod(xi::Mod::SPELLINTERRUPT) < 100 &&
+           !mob.StatusEffectContainer->HasStatusEffect({ xi::StatusEffect::Manafont, xi::StatusEffect::Chainspell });
+}
+
+inline auto beginTell(CBattleEntity& mob, uint32 category, bool interruptible) -> uint32
+{
+    if (mob.objtype != TYPE_MOB || mob.allegiance != xi::Allegiance::Mob || mob.GetLocalVar("OX_NGB_SCRIPTED") != 0)
+    {
+        return 0;
+    }
+    const auto sequence = std::max(mob.GetLocalVar("OX_NGB_SEQUENCE") + 1, 1u);
+    mob.SetLocalVar("OX_NGB_SEQUENCE", sequence);
+    mob.SetLocalVar("OX_NGB_TELL", category);
+    mob.SetLocalVar("OX_NGB_INTERRUPTIBLE", interruptible ? 1 : 0);
+    mob.SetLocalVar("OX_NGB_SEALED_SEQ", 0);
+    return sequence;
+}
+
+inline void endTell(CBattleEntity& mob, uint32& sequence)
+{
+    if (sequence != 0 && mob.GetLocalVar("OX_NGB_SEQUENCE") == sequence)
+    {
+        mob.SetLocalVar("OX_NGB_TELL", 0);
+        mob.SetLocalVar("OX_NGB_INTERRUPTIBLE", 0);
+        mob.SetLocalVar("OX_NGB_SEALED_SEQ", 0);
+    }
+    sequence = 0;
+}
+} // namespace nightblade
