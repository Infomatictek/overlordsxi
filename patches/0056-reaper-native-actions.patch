diff --git a/src/map/utils/reaper_actions.h b/src/map/utils/reaper_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/reaper_actions.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "entities/char_entity.h"
+
+namespace reaper
+{
+inline constexpr uint16 Finality = 77;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::DRK && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_RPR_ACTIVE") == 1;
+}
+
+inline void openRecovery(CBattleEntity& mob)
+{
+    const auto now = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    mob.SetLocalVar("OX_RPR_ROUNDS", 0);
+    mob.SetLocalVar("OX_RPR_OPEN_UNTIL", static_cast<uint32>(now + 5));
+}
+
+// A mob spell or TP action can hit several targets. Count actual hostile HP loss once,
+// after the action resolves. Ordinary melee and damage-over-time run outside this scope.
+class ObserveEnemyAction
+{
+public:
+    explicit ObserveEnemyAction(CBattleEntity& mob)
+    : mob_(mob)
+    {
+        if (mob_.objtype == TYPE_MOB && mob_.allegiance == xi::Allegiance::Mob)
+        {
+            mob_.SetLocalVar("OX_RPR_ACTION", 1);
+        }
+    }
+
+    ~ObserveEnemyAction()
+    {
+        const auto observed = mob_.GetLocalVar("OX_RPR_ACTION");
+        mob_.SetLocalVar("OX_RPR_ACTION", 0);
+        if (observed == 2 && mob_.isAlive())
+        {
+            openRecovery(mob_);
+        }
+    }
+
+private:
+    CBattleEntity& mob_;
+};
+} // namespace reaper
