diff --git a/src/map/utils/valkyrie_actions.h b/src/map/utils/valkyrie_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/valkyrie_actions.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "common/timer.h"
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+#include "spell.h"
+
+namespace valkyrie
+{
+inline constexpr uint16 Wingmate = 273;
+inline constexpr uint16 Escort   = 275;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::WHM && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_VLK_ACTIVE") == 1;
+}
+
+inline auto isKitAbility(uint16 id) -> bool
+{
+    return id == Wingmate || id == Escort;
+}
+
+inline auto hasPolearm(const CCharEntity* character) -> bool
+{
+    const auto* weapon = dynamic_cast<const CItemWeapon*>(character->m_Weapons[SLOT_MAIN]);
+    return weapon && weapon->getSkillType() == xi::SkillType::Polearm;
+}
+
+inline auto canEquipPolearm(const CCharEntity* character, const CItemEquipment* item) -> bool
+{
+    if (!isActive(character))
+    {
+        return false;
+    }
+
+    switch (item->getID())
+    {
+        case 16833: // Bronze Spear
+        case 16835: // Spear
+        case 16836: // Halberd
+        case 16839: // Partisan
+        case 16842: // Golden Spear
+            return true;
+        default:
+            return false;
+    }
+}
+
+inline auto nowSecond() -> uint32
+{
+    return static_cast<uint32>(std::chrono::duration_cast<std::chrono::seconds>(timer::now().time_since_epoch()).count());
+}
+} // namespace valkyrie
