+void CRecastContainer::RestoreCharge(xi::RecastType type, xi::Recast id, uint8 count)
+{
+    if (count == 0)
+    {
+        return;
+    }
+
+    if (auto* recast = GetRecast(type, id))
+    {
+        if (recast->chargeTime > 0s && recast->RecastTime > 0s)
+        {
+            const auto reduction = recast->chargeTime * count;
+            if (recast->RecastTime <= reduction)
+            {
+                recast->RecastTime = 0s;
+            }
+            else
+            {
+                recast->RecastTime -= reduction;
+            }
+        }
+    }
+}
