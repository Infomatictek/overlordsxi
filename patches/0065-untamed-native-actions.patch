diff --git a/src/map/utils/untamed_actions.h b/src/map/utils/untamed_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/untamed_actions.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "ability.h"
+#include "entities/battle_entity.h"
+
+namespace untamed
+{
+inline auto isActive(const CBattleEntity* entity) -> bool
+{
+    return entity && entity->objtype == TYPE_PC && entity->GetMJob() == xi::Job::BST &&
+           entity->GetMLevel() >= 10 && entity->GetLocalVar("OX_UNT_ACTIVE") == 1;
+}
+
+inline auto kitAbility(uint16 id, uint8 level) -> bool
+{
+    switch (id)
+    {
+        case ABILITY_CHARM:
+        case ABILITY_FIGHT:
+        case ABILITY_HEEL:
+        case ABILITY_LEAVE:
+        case ABILITY_REWARD:
+        case ABILITY_CALL_BEAST:
+        case ABILITY_READY:
+        case ABILITY_FOOT_KICK:
+            return true;
+        case ABILITY_BESTIAL_LOYALTY:
+            return level >= 30;
+        default:
+            return false;
+    }
+}
+} // namespace untamed
