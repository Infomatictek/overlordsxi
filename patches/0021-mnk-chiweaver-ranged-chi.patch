+void ExecuteChiRangedAttack(CCharEntity* PChar, CBattleEntity* PTarget, action_t& action)
+{
+    if (PChar == nullptr || PTarget == nullptr || !PTarget->isAlive() || !PChar->isAlive())
+    {
+        return;
+    }
+
+    // Swings both unarmed fists (Right = 0, Left/Off-hand = 1), plus optional Kick Attack (2).
+    std::array<std::pair<uint8, AttackAnimation>, 3> swings{};
+    std::size_t                                      swingCount = 0;
+    swings[swingCount++]                                        = { 1, AttackAnimation::RIGHTATTACK };
+    swings[swingCount++]                                        = { 2, AttackAnimation::LEFTATTACK };
+
+    const int16 kickRate = std::clamp<int16>(PChar->getMod(xi::Mod::KICK_ATTACK_RATE), 0, 100);
+    if (kickRate > 0 && xirand::GetRandomNumber(100) < static_cast<uint16>(kickRate))
+    {
+        swings[swingCount++] = { 3, AttackAnimation::RIGHTKICK };
+    }
+
+    action_target_t* pList = nullptr;
+
+    for (std::size_t i = 0; i < swingCount; ++i)
+    {
+        if (!PTarget->isAlive() || !PChar->isAlive())
+        {
+            break;
+        }
+
+        const int32 dmg = luautils::ExecuteChiRangedAttack(PChar, PTarget, swings[i].first);
+        if (dmg < -1)
+        {
+            break;
+        }
+
+        if (pList == nullptr)
+        {
+            action.actiontype = ActionCategory::BasicAttack;
+            action.actorId    = PChar->id;
+            pList             = &action.addTarget(PTarget->id);
+        }
+
+        action_result_t& result = pList->addResult();
+        result.animation        = static_cast<ActionAnimation>(swings[i].second);
+
+        if (dmg < 0)
+        {
+            result.resolution = ActionResolution::Miss;
+            result.messageID  = MsgBasic::AttackMisses;
+            continue;
+        }
+
+        result.resolution = ActionResolution::Hit;
+        result.messageID  = MsgBasic::AttackHits;
+        result.recordDamage(attack_outcome_t{
+            .atkType    = xi::AttackType::Magical,
+            .damage     = std::max<int32>(0, dmg),
+            .target     = PTarget,
+            .isCritical = false,
+        });
+    }
+
+    if (pList != nullptr && PChar->GetLocalVar("OX_CHW_BOOST_NEXT") == 1)
+    {
+        PChar->SetLocalVar("OX_CHW_BOOST_NEXT", 0);
+    }
+}
