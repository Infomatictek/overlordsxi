+void CLuaBaseEntity::sendTalentPacket(std::string const& payload)
+{
+    if (m_PBaseEntity->objtype != TYPE_PC)
+    {
+        return;
+    }
+
+    auto*                 PChar         = static_cast<CCharEntity*>(m_PBaseEntity);
+    constexpr std::size_t HeaderBytes   = 12;
+    constexpr std::size_t MaxPayloadLen = 236;
+    const std::size_t     len           = std::min<std::size_t>(payload.size(), MaxPayloadLen);
+    const std::size_t     totalBytes    = ((HeaderBytes + len + 3) / 4) * 4;
+
+    auto packet = std::make_unique<CBasicPacket>();
+    packet->setType(0x1FD);
+    packet->setSize(totalBytes);
+    packet->ref<uint8>(0x04)  = 'O';
+    packet->ref<uint8>(0x05)  = 'X';
+    packet->ref<uint8>(0x06)  = 'T';
+    packet->ref<uint8>(0x07)  = 'L';
+    packet->ref<uint8>(0x08)  = 1;
+    packet->ref<uint8>(0x09)  = 0;
+    packet->ref<uint16>(0x0A) = static_cast<uint16>(len);
+    for (std::size_t i = 0; i < len; ++i)
+    {
+        packet->ref<uint8>(HeaderBytes + i) = static_cast<uint8>(payload[i]);
+    }
+
+    PChar->pushPacket(std::move(packet));
+}
