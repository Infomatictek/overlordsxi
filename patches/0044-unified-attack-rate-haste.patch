diff --git a/src/map/entities/battle_entity.cpp b/src/map/entities/battle_entity.cpp
--- a/src/map/entities/battle_entity.cpp
+++ b/src/map/entities/battle_entity.cpp
@@ -553,10 +553,17 @@
                 }
 
-                hasteMagic   = std::clamp<float>(hasteMagic, -1.0f, 0.4375f);
-                hasteAbility = std::clamp<float>(hasteAbility, -0.25f, 0.25f);
-                hasteGear    = std::min(hasteGear, 0.25f);
-
-                float hasteCap  = 1.0f - settings::get<float>("main.DELAY_REDUCTION_CAP");
-                hasteMultiplier = std::clamp<float>(1.0f - hasteMagic - hasteAbility - hasteGear, hasteCap, 2.0f);
+                // OverlordsXI: no gear/magic/ability haste category caps.
+                // At 15% innate (magic slot) + 10% ability, un-geared players
+                // retain the original 25%-delay-reduction pace (4/3 rate).
+                // Gear haste is a strong, independent multiplier; Soul and party
+                // haste have smooth diminishing returns instead of hard caps.
+                const float otherHaste = hasteMagic + hasteAbility;
+                const float otherRate  = otherHaste >= 0.0f
+                                             ? 1.0f + (5.0f / 3.0f) * otherHaste / (1.0f + otherHaste)
+                                             : 1.0f / (1.0f - otherHaste);
+                const float gearRate   = hasteGear >= 0.0f
+                                             ? 1.0f + 1.5f * hasteGear
+                                             : 1.0f / (1.0f - 1.5f * hasteGear);
+                hasteMultiplier = 1.0f / (otherRate * gearRate);
             }
         }
