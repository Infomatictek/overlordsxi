+/************************************************************************
+ *  Function: getLancerLanding()
+ *  Purpose : Find a safe, same-zone landing for Spineshatter Vault.
+ ************************************************************************/
+
+auto CLuaBaseEntity::getLancerLanding(const CLuaBaseEntity* luaTarget) -> sol::object
+{
+    auto* player = dynamic_cast<CCharEntity*>(m_PBaseEntity);
+    auto* target = luaTarget ? dynamic_cast<CBattleEntity*>(luaTarget->GetBaseEntity()) : nullptr;
+    if (!lancer::isActive(player) || !lancer::hasPolearm(player) || !target || target->objtype != TYPE_MOB ||
+        !target->isAlive() || !player->loc.zone || player->loc.zone != target->loc.zone ||
+        player->getBattleID() != target->getBattleID() || player->entityId().instanceRunId != target->entityId().instanceRunId ||
+        !player->CanSeeTarget(target))
+    {
+        return sol::lua_nil;
+    }
+
+    const auto start = player->loc.p;
+    const auto goal = target->loc.p;
+    const auto lane = distance(start, goal, true);
+    const auto standOff = std::max(2.5f, target->modelHitboxSize + player->modelHitboxSize + 0.5f);
+    if (distance(start, goal) < 4.0f || distance(start, goal) > 12.0f || lane <= standOff + 0.25f ||
+        std::abs(start.y - goal.y) > 2.0f)
+    {
+        return sol::lua_nil;
+    }
+
+    const auto fraction = (lane - standOff) / lane;
+    auto requested = goal;
+    requested.x = start.x + (goal.x - start.x) * fraction;
+    requested.z = start.z + (goal.z - start.z) * fraction;
+    const auto* mesh = player->loc.zone->navMesh();
+    const auto ground = mesh->findClosestValidPoint(requested);
+    position_t reached{};
+    if (!ground || distance(*ground, requested) > 0.75f || !mesh->moveAlongSurface(start, *ground, reached) ||
+        distance(reached, *ground) > 0.40f || !player->CanSeeTarget(reached))
+    {
+        return sol::lua_nil;
+    }
+
+    return lua.create_table_with("x", reached.x, "y", reached.y, "z", reached.z, "rotation", worldAngle(reached, goal));
 }
 
