diff --git a/src/map/utils/bandit_actions.h b/src/map/utils/bandit_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/bandit_actions.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include "entities/char_entity.h"
+
+namespace bandit
+{
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::THF && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_BND_ACTIVE") == 1;
+}
+
+inline auto isKitAbility(uint16 id) -> bool
+{
+    return id == 44 || id == 45;
+}
+} // namespace bandit
