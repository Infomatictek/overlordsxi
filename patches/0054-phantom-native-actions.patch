diff --git a/src/map/utils/phantom_actions.h b/src/map/utils/phantom_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/phantom_actions.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+
+namespace phantom
+{
+inline constexpr uint16 Dare = 41;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::THF && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_PHN_ACTIVE") == 1;
+}
+
+inline auto canEquipKatana(const CCharEntity* character, const CItemEquipment* item) -> bool
+{
+    if (!isActive(character))
+    {
+        return false;
+    }
+    switch (item->getID())
+    {
+        case 16896: // Kunai
+        case 16900: // Wakizashi
+        case 16901: // Kodachi
+        case 17795: // Sai
+        case 17791: // Rai Kunimitsu
+            return true;
+        default:
+            return false;
+    }
+}
+} // namespace phantom
