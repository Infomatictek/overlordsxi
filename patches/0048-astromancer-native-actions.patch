diff --git a/src/map/utils/astromancer_actions.h b/src/map/utils/astromancer_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/astromancer_actions.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include "common/timer.h"
+#include "entities/char_entity.h"
+#include "spell.h"
+
+namespace astromancer
+{
+struct SpellProfile
+{
+    uint8 level;
+    uint8 mpCost;
+    uint8 mpPercent;
+    uint8 recastSeconds;
+    bool ancient;
+};
+
+inline constexpr uint16 GatherAether = 75;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::BLM && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_AST_ACTIVE") == 1;
+}
+
+inline auto spellProfile(SpellID id) -> SpellProfile
+{
+    switch (id)
+    {
+        case SpellID::Fire:      return { 10,   6,  0,  3, false };
+        case SpellID::Blizzard:  return { 10,   8,  0,  3, false };
+        case SpellID::Aero:      return { 10,   6,  0,  3, false };
+        case SpellID::Stone:     return { 10,   4,  0,  3, false };
+        case SpellID::Thunder:   return { 10,   9,  0,  3, false };
+        case SpellID::Water:     return { 10,   5,  0,  3, false };
+        case SpellID::Stone_II:  return { 10,   0, 16, 18, true };
+        case SpellID::Burn:      return { 30,   0,  2, 30, false };
+        case SpellID::Warp:      return { 30, 100,  0, 10, false };
+        case SpellID::Flare:
+        case SpellID::Freeze:
+        case SpellID::Tornado:
+        case SpellID::Quake:
+        case SpellID::Burst:
+        case SpellID::Flood:
+            return { 50, 0, 22, 18, true };
+        default:
+            return {};
+    }
+}
+
+inline auto ancientReady(const CCharEntity* character) -> bool
+{
+    const auto now = std::chrono::duration_cast<std::chrono::seconds>(timer::now().time_since_epoch()).count();
+    return character->GetLocalVar("OX_AST_RECOVERY") <= now;
+}
+} // namespace astromancer
