diff --git a/src/map/utils/skyborn_actions.h b/src/map/utils/skyborn_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/skyborn_actions.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+
+namespace skyborn
+{
+inline constexpr uint16 Guard = 65;
+inline constexpr uint16 Cry = 66;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::DRG && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_SKY_ACTIVE") == 1;
+}
+
+inline auto isKitAbility(uint16 ability) -> bool
+{
+    return ability == Guard || ability == Cry;
+}
+
+inline auto hasPolearm(const CCharEntity* character) -> bool
+{
+    const auto* weapon = dynamic_cast<const CItemWeapon*>(character->m_Weapons[SLOT_MAIN]);
+    return weapon && weapon->getSkillType() == xi::SkillType::Polearm;
+}
+} // namespace skyborn
