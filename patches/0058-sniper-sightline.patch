+auto CRangeState::validSightlineTarget(CCharEntity* player, CBattleEntity* target) const -> bool
+{
+    if (!sniper::isActive(player) || !player->isAlive() || player->GetMLevel() != m_sightlineLevel ||
+        player->StatusEffectContainer->HasPreventActionEffect() ||
+        player->StatusEffectContainer->HasStatusEffect(xi::StatusEffect::Amnesia) ||
+        player->battleTarget() != m_originalBattleTarget || HasMoved() ||
+        !target || target->loc.zone != player->loc.zone || !target->isAlive() || target->PAI->IsUntargetable() ||
+        !player->CanSeeTarget(target) || !facing(player->loc.p, target->loc.p, 64) ||
+        distance(player->loc.p, target->loc.p) > sniper::MaxRange)
+    {
+        return false;
+    }
+
+    const auto* weapon = dynamic_cast<CItemWeapon*>(player->getEquip(SLOT_RANGED));
+    const auto* ammo = dynamic_cast<CItemWeapon*>(player->getEquip(SLOT_AMMO));
+    return sniper::usesMarksmanship(weapon, ammo) && weapon->getID() == m_sightlineWeapon && ammo->getID() == m_sightlineAmmo;
+}
+
+void CRangeState::finishSightline(bool released)
+{
+    m_sightlinePending = false;
+    auto* player = static_cast<CCharEntity*>(m_PEntity);
+    const auto duration = released ? 12 : 3;
+    player->SetLocalVar("OX_SNP_AIM_UNTIL", 0);
+    player->SetLocalVar("OX_SNP_RECAST_UNTIL", sniper::nowSecond() + duration);
+    player->PRecastContainer->Add(xi::RecastType::Ability, static_cast<xi::Recast>(sniper::SightlineRecast), std::chrono::seconds(duration));
+    if (player->loc.zone)
+    {
+        player->pushPacket<GP_SERV_COMMAND_CLISTATUS2>(player);
+        player->pushPacket<GP_SERV_COMMAND_ABIL_RECAST>(player);
+    }
 }
 
