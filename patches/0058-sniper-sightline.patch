@@ -0,0 +1,49 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+
+namespace sniper
+{
+inline constexpr uint16 Sightline = 57;
+inline constexpr uint16 DeepSight = 59;
+inline constexpr uint16 SightlineRecast = 122;
+inline constexpr auto MaxRange = 20.0f;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::RNG && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_SNP_ACTIVE") == 1;
+}
+
+inline auto kitAbility(uint16 id, uint8 level) -> bool
+{
+    return id == Sightline || (id == DeepSight && level >= 50);
+}
+
+inline auto nowSecond() -> uint32
+{
+    return static_cast<uint32>(std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline auto usesMarksmanship(const CItemWeapon* weapon, const CItemWeapon* ammo) -> bool
+{
+    return weapon && ammo && ammo->getQuantity() != 0 &&
+           weapon->getSkillType() == xi::SkillType::Marksmanship && ammo->getSkillType() == xi::SkillType::Marksmanship &&
+           weapon->getSubSkillType() == ammo->getSubSkillType();
+}
+
+inline constexpr auto aimBonus(uint8 level) -> int16
+{
+    return level >= 70 ? 30 : level >= 30 ? 20 : 10;
+}
+
+inline constexpr auto damagePercent(uint8 level, bool deep) -> int32
+{
+    if (deep && level >= 50)
+    {
+        return level >= 70 ? 320 : 280;
+    }
+    return level >= 30 ? 230 : 200;
+}
+} // namespace sniper
