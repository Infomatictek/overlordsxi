@@ -6953,4 +6953,34 @@ auto ExecuteChiRangedAttack(CCharEntity* PChar, CBattleEntity* PTarget, uint8 sw
     return -2;
 }
 
+auto OnPreTakeDamage(CBattleEntity* PDefender, int32 amount, CBattleEntity* PAttacker, uint16 attackType, uint16 damageType) -> int32
+{
+    if (PDefender == nullptr || amount <= 0)
+    {
+        return amount;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.onPreTakeDamage");
+    if (!func.valid())
+    {
+        return amount;
+    }
+
+    const auto result = func(PDefender, amount, PAttacker, attackType, damageType);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::OnPreTakeDamage: %s", err.what());
+        return amount;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.is<int32>())
+    {
+        return std::max<int32>(0, retObj.as<int32>());
+    }
+
+    return amount;
+}
+
 }; // namespace luautils
