+auto GetExtraSpecAbilities(CCharEntity* PChar) -> std::vector<uint16>
+{
+    std::vector<uint16> abilities;
+    if (PChar == nullptr)
+    {
+        return abilities;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.spec.getExtraAbilities");
+    if (!func.valid())
+    {
+        return abilities;
+    }
+
+    const auto result = func(PChar);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::GetExtraSpecAbilities: %s", err.what());
+        return abilities;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.get_type() == sol::type::table)
+    {
+        const sol::table retTbl = retObj.as<sol::table>();
+        for (std::size_t i = 1; i <= retTbl.size(); ++i)
+        {
+            const sol::object entry = retTbl[i];
+            if (entry.valid() && entry.is<uint16>())
+            {
+                abilities.push_back(entry.as<uint16>());
+            }
+        }
+    }
+
+    return abilities;
+}
+
+auto GetExtraSpecTraits(CCharEntity* PChar) -> std::vector<uint16>
+{
+    std::vector<uint16> traitsList;
+    if (PChar == nullptr)
+    {
+        return traitsList;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.spec.getExtraTraits");
+    if (!func.valid())
+    {
+        return traitsList;
+    }
+
+    const auto result = func(PChar);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::GetExtraSpecTraits: %s", err.what());
+        return traitsList;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.get_type() == sol::type::table)
+    {
+        const sol::table retTbl = retObj.as<sol::table>();
+        for (std::size_t i = 1; i <= retTbl.size(); ++i)
+        {
+            const sol::object entry = retTbl[i];
+            if (entry.valid() && entry.is<uint16>())
+            {
+                traitsList.push_back(entry.as<uint16>());
+            }
+        }
+    }
+
+    return traitsList;
+}
+
+void OnTraitsTableBuilt(CCharEntity* PChar)
+{
+    if (PChar == nullptr)
+    {
+        return;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.spec.onTraitsRebuild");
+    if (!func.valid())
+    {
+        return;
+    }
+
+    const auto result = func(PChar);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::OnTraitsTableBuilt: %s", err.what());
+    }
+}
+
+auto CanUseTalentWeaponskill(CCharEntity* PChar, uint16 wsId) -> bool
+{
+    if (PChar == nullptr || wsId == 0)
+    {
+        return false;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.wsTalents.isWSUnlocked");
+    if (!func.valid())
+    {
+        return false;
+    }
+
+    const auto result = func(PChar, wsId);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::CanUseTalentWeaponskill: %s", err.what());
+        return false;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.is<bool>())
+    {
+        return retObj.as<bool>();
+    }
+
+    return false;
+}
+
+void OnTalentPacket(CCharEntity* PChar, uint8 operation, uint16 wsId, uint8 arg1, uint8 arg2)
+{
+    if (PChar == nullptr)
+    {
+        return;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.wsTalents.handleClientPacket");
+    if (!func.valid())
+    {
+        return;
+    }
+
+    const auto result = func(PChar, operation, wsId, arg1, arg2);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::OnTalentPacket: %s", err.what());
+    }
+}
+
+auto ExecuteChiRangedAttack(CCharEntity* PChar, CBattleEntity* PTarget, uint8 swingIndex) -> int32
+{
+    if (PChar == nullptr || PTarget == nullptr)
+    {
+        return -2;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.mnk.executeChiRangedAttack");
+    if (!func.valid())
+    {
+        return -2;
+    }
+
+    const auto result = func(PChar, PTarget, swingIndex);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::ExecuteChiRangedAttack: %s", err.what());
+        return -2;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.is<int32>())
+    {
+        return retObj.as<int32>();
+    }
+
+    return -2;
+}
+
+auto OnPreTakeDamage(CBattleEntity* PDefender, int32 amount, CBattleEntity* PAttacker, uint16 attackType, uint16 damageType) -> int32
+{
+    if (PDefender == nullptr || amount <= 0)
+    {
+        return amount;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.onPreTakeDamage");
+    if (!func.valid())
+    {
+        return amount;
+    }
+
+    const auto result = func(PDefender, amount, PAttacker, attackType, damageType);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::OnPreTakeDamage: %s", err.what());
+        return amount;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.is<int32>())
+    {
+        return std::max<int32>(0, retObj.as<int32>());
+    }
+
+    return amount;
+}
+
 }; // namespace luautils
