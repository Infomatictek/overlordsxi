+struct DotAttributionEntry
+{
+    xi::StatusEffect statusId{ xi::StatusEffect::None };
+    uint32           originId{ 0 };
+    int32            regenDown{ 0 };
+};
+
+auto ResolveDotOrigin(CBattleEntity* PTarget, uint32 originId) -> CBattleEntity*
+{
+    if (originId == 0 || PTarget == nullptr)
+    {
+        return nullptr;
+    }
+
+    CBaseEntity* POrigin = nullptr;
+    if (originId < 0x01000000)
+    {
+        if (PTarget->loc.zone != nullptr)
+        {
+            POrigin = PTarget->loc.zone->GetCharByID(originId);
+        }
+
+        if (POrigin == nullptr)
+        {
+            POrigin = zoneutils::GetChar(originId);
+        }
+    }
+    else
+    {
+        if (PTarget->PInstance != nullptr)
+        {
+            const uint16 targId = static_cast<uint16>(originId & 0x00000800 ? (originId & 0x7FF) + 0x700 : originId & 0xFFF);
+            POrigin             = PTarget->GetEntity(targId);
+        }
+
+        if (POrigin == nullptr)
+        {
+            POrigin = zoneutils::GetEntity(originId);
+        }
+    }
+
+    if (POrigin != nullptr && POrigin->id != originId)
+    {
+        return nullptr;
+    }
+
+    return dynamic_cast<CBattleEntity*>(POrigin);
+}
+
+auto IsPlayerSideDotOrigin(const CBattleEntity* PTarget, const CBattleEntity* POrigin) -> bool
+{
+    if (PTarget == nullptr || POrigin == nullptr || POrigin == PTarget)
+    {
+        return false;
+    }
+
+    if (POrigin->objtype == TYPE_PC || POrigin->objtype == TYPE_TRUST || POrigin->objtype == TYPE_FELLOW)
+    {
+        return true;
+    }
+
+    if (POrigin->objtype == TYPE_PET)
+    {
+        return POrigin->PMaster == nullptr || POrigin->PMaster->objtype == TYPE_PC;
+    }
+
+    return false;
+}
+
+auto GetDisplayEntityName(const CBattleEntity* PEntity) -> std::string
+{
+    if (PEntity == nullptr)
+    {
+        return "";
+    }
+
+    std::string name = !PEntity->packetName.empty() ? PEntity->packetName : PEntity->getName();
+    std::replace(name.begin(), name.end(), '_', ' ');
+    return name;
+}
+
+auto GetDotDisplayName(xi::StatusEffect statusId) -> std::string
+{
+    switch (statusId)
+    {
+        case xi::StatusEffect::Poison:
+            return "Poison";
+        case xi::StatusEffect::Kaustra:
+            return "Kaustra";
+        case xi::StatusEffect::Burn:
+            return "Burn";
+        case xi::StatusEffect::Frost:
+            return "Frost";
+        case xi::StatusEffect::Choke:
+            return "Choke";
+        case xi::StatusEffect::Rasp:
+            return "Rasp";
+        case xi::StatusEffect::Shock:
+            return "Shock";
+        case xi::StatusEffect::Drown:
+            return "Drown";
+        case xi::StatusEffect::Dia:
+            return "Dia";
+        case xi::StatusEffect::Bio:
+            return "Bio";
+        case xi::StatusEffect::Helix:
+            return "Helix";
+        case xi::StatusEffect::Requiem:
+            return "Requiem";
+        default:
+            break;
+    }
+
+    if (static_cast<uint16>(statusId) == 540)
+    {
+        return "Geo-Poison";
+    }
+
+    std::string raw = effects::GetEffectName(static_cast<uint16>(statusId));
+    if (raw.empty())
+    {
+        return "DoT";
+    }
+
+    bool capitalizeNext = true;
+    for (char& ch : raw)
+    {
+        if (ch == '_')
+        {
+            ch             = ' ';
+            capitalizeNext = true;
+        }
+        else if (capitalizeNext)
+        {
+            ch             = static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+            capitalizeNext = false;
+        }
+    }
+
+    return raw;
+}
+
+void EmitDotDamageLog(CBattleEntity* PTarget, CBattleEntity* POrigin, xi::StatusEffect statusId, int32 damage)
+{
+    if (PTarget == nullptr || PTarget->objtype != TYPE_MOB || PTarget->loc.zone == nullptr || damage <= 0)
+    {
+        return;
+    }
+
+    if (!IsPlayerSideDotOrigin(PTarget, POrigin))
+    {
+        return;
+    }
+
+    const std::string casterName = GetDisplayEntityName(POrigin);
+    const std::string targetName = GetDisplayEntityName(PTarget);
+    if (casterName.empty() || targetName.empty())
+    {
+        return;
+    }
+
+    const std::string effectName = GetDotDisplayName(statusId);
+    const char*       pointWord  = damage == 1 ? "point" : "points";
+    const std::string message    = fmt::format("{}'s {} deals {} {} of damage to {}.", casterName, effectName, damage, pointWord, targetName);
+
+    PTarget->loc.zone->PushPacket(PTarget, CHAR_INRANGE, std::make_unique<GP_SERV_COMMAND_CHAT_STD>("", PTarget->getZone(), MESSAGE_SYSTEM_3, message));
+}
+
