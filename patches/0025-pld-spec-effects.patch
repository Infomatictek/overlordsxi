@@ -1083,6 +1083,19 @@ auto CBattleEntity::takeDamage(int32 amount, CBattleEntity* attacker /* = nullpt
     }
     this->BattleHistory.lastHitTaken_atkType = attackType;
 
+    if (amount > 0 && !isSkillchainDamage &&
+        (attackType == xi::AttackType::Physical || attackType == xi::AttackType::Magical) &&
+        (this->objtype == TYPE_PC || this->objtype == TYPE_TRUST || this->objtype == TYPE_PET))
+    {
+        static thread_local bool inPreTakeDamage = false;
+        if (!inPreTakeDamage)
+        {
+            inPreTakeDamage = true;
+            amount          = luautils::OnPreTakeDamage(this, amount, attacker, static_cast<uint16>(attackType), static_cast<uint16>(damageType));
+            inPreTakeDamage = false;
+        }
+    }
+
     PAI->EventHandler.triggerListener("TAKE_DAMAGE", this, amount, attacker, (uint16)attackType, (uint16)damageType);
 
     // RoE Damage Taken Trigger
diff --git a/src/map/lua/luautils.cpp b/src/map/lua/luautils.cpp
diff --git a/src/map/lua/luautils.cpp b/src/map/lua/luautils.cpp
--- a/src/map/lua/luautils.cpp
+++ b/src/map/lua/luautils.cpp
@@ -6953,4 +6953,34 @@ auto ExecuteChiRangedAttack(CCharEntity* PChar, CBattleEntity* PTarget, uint8 sw
     return -2;
 }
 
+auto OnPreTakeDamage(CBattleEntity* PDefender, int32 amount, CBattleEntity* PAttacker, uint16 attackType, uint16 damageType) -> int32
+{
+    if (PDefender == nullptr || amount <= 0)
+    {
+        return amount;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.onPreTakeDamage");
+    if (!func.valid())
+    {
+        return amount;
+    }
+
+    const auto result = func(PDefender, amount, PAttacker, attackType, damageType);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::OnPreTakeDamage: %s", err.what());
+        return amount;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.is<int32>())
+    {
+        return std::max<int32>(0, retObj.as<int32>());
+    }
+
+    return amount;
+}
+
 }; // namespace luautils
