diff --git a/src/map/utils/trickster_actions.h b/src/map/utils/trickster_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/trickster_actions.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include "entities/char_entity.h"
+
+namespace trickster
+{
+inline constexpr uint16 PassTheBlame = 76;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::THF && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_TRK_ACTIVE") == 1;
+}
+} // namespace trickster
