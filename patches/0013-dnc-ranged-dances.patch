+auto getEffectiveAbilityRange(CBattleEntity* PEntity, const CAbility* PAbility) -> float
+{
+    if (PEntity == nullptr || PAbility == nullptr)
+    {
+        return 0.0f;
+    }
+
+    float range = PAbility->getRange();
+    if (auto* PChar = dynamic_cast<CCharEntity*>(PEntity);
+        PChar != nullptr && PChar->GetLocalVar("OX_DNC_RANGED") == 1)
+    {
+        switch (PAbility->getID())
+        {
+            case ABILITY_QUICKSTEP:
+            case ABILITY_BOX_STEP:
+            case ABILITY_STUTTER_STEP:
+            case ABILITY_FEATHER_STEP:
+            case ABILITY_DESPERATE_FLOURISH:
+            case ABILITY_VIOLENT_FLOURISH:
+            case ABILITY_WILD_FLOURISH:
+                return std::max(range, 20.0f);
+            default:
+                break;
+        }
+    }
+
+    return range;
+}
