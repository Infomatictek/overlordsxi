diff --git a/src/map/utils/herald_actions.h b/src/map/utils/herald_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/herald_actions.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "lua/luautils.h"
+#include "utils/primalist_actions.h"
+
+namespace herald
+{
+inline auto isActive(const CCharEntity* entity) -> bool
+{
+    return entity && entity->GetMJob() == xi::Job::SMN && entity->GetMLevel() >= 10 &&
+           entity->GetLocalVar("OX_HLD_ACTIVE") == 1;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    switch (id)
+    {
+        case SpellID::Carbuncle:
+        case SpellID::Ifrit:
+            return 10;
+        case SpellID::Garuda:
+        case SpellID::Shiva:
+            return 30;
+        case SpellID::Titan:
+        case SpellID::Leviathan:
+        case SpellID::Ramuh:
+            return 50;
+        default:
+            return 0;
+    }
+}
+
+inline auto pactForPet(const CCharEntity* entity, uint32 petID) -> uint16
+{
+    for (const auto& avatar : primalist::avatars)
+    {
+        if (avatar.pet == petID)
+        {
+            const auto unlock = spellLevel(avatar.spell);
+            return unlock != 0 && entity->GetMLevel() >= unlock ? avatar.pact : 0;
+        }
+    }
+    return 0;
+}
+
+inline auto playerAbility(uint16 id) -> bool
+{
+    return id == ABILITY_AVATARS_FAVOR || id == ABILITY_ASSAULT || id == ABILITY_RETREAT ||
+           id == ABILITY_RELEASE || id == ABILITY_BLOOD_PACT_RAGE;
+}
+
+template <typename Callback>
+auto settlePetDamage(CBattleEntity* pet, CBaseEntity* owner, CBattleEntity* target, Callback execute) -> int32
+{
+    if (!owner || owner->objtype != TYPE_PC || target->objtype != TYPE_MOB)
+    {
+        return execute();
+    }
+    const auto before = target->health.hp;
+    pet->SetLocalVar("OX_HLD_PET_SCOPE", 1);
+    const auto damage = execute();
+    pet->SetLocalVar("OX_HLD_PET_SCOPE", 0);
+    if (pet->GetLocalVar("OX_HLD_PET_PENDING") != 0)
+    {
+        luautils::callGlobal<void>("xi.soulspire.herald.finishPetClaim", pet, target, before - target->health.hp);
+    }
+    return damage;
+}
+} // namespace herald
