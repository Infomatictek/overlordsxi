+
+void CRecastContainer::ReduceAbilityRecasts(timer::duration reduction)
+{
+    if (reduction <= 0s)
+    {
+        return;
+    }
+
+    RecastList_t* PRecastList = GetRecastList(xi::RecastType::Ability);
+    if (!PRecastList)
+    {
+        return;
+    }
+
+    for (auto&& recast : *PRecastList)
+    {
+        if (recast.RecastTime <= 0s)
+        {
+            continue;
+        }
+        if (recast.ID == xi::Recast::Special || recast.ID == xi::Recast::Special2 || recast.ID == xi::Recast::RandomDeal)
+        {
+            continue;
+        }
+
+        if (recast.RecastTime <= reduction)
+        {
+            recast.RecastTime = 0s;
+        }
+        else
+        {
+            recast.RecastTime -= reduction;
+        }
+    }
+
+    Check();
+}
+
+void CRecastContainer::ResetStandardAbilities()
+{
+    RecastList_t* PRecastList = GetRecastList(xi::RecastType::Ability);
+    if (!PRecastList)
+    {
+        return;
+    }
+
+    for (auto&& recast : *PRecastList)
+    {
+        if (recast.ID != xi::Recast::Special && recast.ID != xi::Recast::Special2 && recast.ID != xi::Recast::RandomDeal)
+        {
+            recast.RecastTime = 0s;
+        }
+    }
+
+    Check();
+}
