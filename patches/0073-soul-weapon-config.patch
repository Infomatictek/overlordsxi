+auto EvaluateSoulWeaponPair(CCharEntity* PChar, CItem* PMain, CItem* PSub) -> int32
+{
+    if (PChar == nullptr)
+    {
+        return 0;
+    }
+
+    const auto func = detail::findGlobalLuaFunction("xi.overlords.weaponConfig.evaluatePair");
+    if (!func.valid())
+    {
+        return 0;
+    }
+
+    const auto result = func(PChar, PMain, PSub);
+    if (!result.valid())
+    {
+        const sol::error err = result;
+        ShowError("luautils::EvaluateSoulWeaponPair: %s", err.what());
+        return 0;
+    }
+
+    const sol::object retObj = result.get<sol::object>();
+    if (retObj.valid() && retObj.is<int32>())
+    {
+        return retObj.as<int32>();
+    }
+
+    return 0;
+}
+
 }; // namespace luautils
