+
+void CLuaBaseEntity::resolveTerramancerFault(CLuaBaseEntity* luaTarget, bool deep)
+{
+    auto* caster = dynamic_cast<CCharEntity*>(m_PBaseEntity);
+    auto* target = luaTarget ? dynamic_cast<CMobEntity*>(luaTarget->GetBaseEntity()) : nullptr;
+    if (!terramancer::isActive(caster) || !caster->isAlive() || !target || !target->isAlive() ||
+        target->PMaster || target->allegiance == caster->allegiance || caster->loc.zone != target->loc.zone ||
+        caster->getBattleID() != target->getBattleID() || caster->entityId().instanceRunId != target->entityId().instanceRunId ||
+        (deep && caster->GetMLevel() < 30) || !battleutils::HasClaim(caster, target) || target->PAI->IsUntargetable())
+    {
+        return;
+    }
+
+    auto* base = spell::GetSpell(SpellID::Stone);
+    if (!base)
+    {
+        return;
+    }
+    auto stone = base->clone();
+    stone->setPrimaryTargetID(target->id);
+    stone->setTotalTargets(1);
+
+    action_t action{};
+    action.actorId    = caster->id;
+    action.actiontype = ActionCategory::MagicFinish;
+    action.actionid   = static_cast<uint16>(deep ? SpellID::Stone_III : SpellID::Stone_II);
+    action.spellgroup = stone->getSpellGroup();
+    if (const auto* recast = caster->PRecastContainer->GetRecast(xi::RecastType::Magic, static_cast<xi::Recast>(action.actionid)))
+    {
+        action.recast = std::max<timer::duration>(0s, recast->TimeStamp + recast->RecastTime - timer::now());
+    }
+    auto& result      = action.addTarget(target->id).addResult();
+    result.animation  = stone->getAnimationID();
+    result.resolution = ActionResolution::Hit;
+    if (stone->canHitShadow() && battleutils::IsAbsorbByShadow(target, caster))
+    {
+        result.param     = 1;
+        result.messageID = MsgBasic::ShadowAbsorb;
+    }
+    else
+    {
+        caster->SetLocalVar("OX_TRM_SCALAR", terramancer::multiplier(caster->GetMLevel(), deep));
+        result.param = luautils::OnSpellCast(caster, target, stone.get(), &action);
+        caster->SetLocalVar("OX_TRM_SCALAR", 0);
+        result.messageID = stone->getMessage();
+        luautils::OnMagicHit(caster, target, stone.get());
+    }
+    caster->loc.zone->PushPacket(caster, CHAR_INRANGE_SELF, std::make_unique<GP_SERV_COMMAND_BATTLE2>(action));
 }
 
