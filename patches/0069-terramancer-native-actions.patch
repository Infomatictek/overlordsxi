diff --git a/src/map/utils/terramancer_actions.h b/src/map/utils/terramancer_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/terramancer_actions.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "spell.h"
+
+namespace terramancer
+{
+inline auto isActive(const CCharEntity* entity) -> bool
+{
+    return entity && entity->GetMJob() == xi::Job::GEO && entity->GetMLevel() >= 10 &&
+           entity->GetLocalVar("OX_TRM_ACTIVE") == 1;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    switch (id)
+    {
+        case SpellID::Stone:
+        case SpellID::Stone_II:
+            return 10;
+        case SpellID::Stone_III:
+            return 30;
+        default:
+            return 0;
+    }
+}
+
+inline auto isFault(SpellID id) -> bool
+{
+    return id == SpellID::Stone_II || id == SpellID::Stone_III;
+}
+
+inline auto multiplier(uint8 level, bool deep) -> uint32
+{
+    if (deep)
+    {
+        return level >= 70 ? 360 : level >= 50 ? 320 : 280;
+    }
+    return level >= 70 ? 220 : level >= 50 ? 200 : 180;
+}
+} // namespace terramancer
