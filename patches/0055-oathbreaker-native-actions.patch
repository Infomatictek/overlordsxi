diff --git a/src/map/utils/oathbreaker_actions.h b/src/map/utils/oathbreaker_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/oathbreaker_actions.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+
+namespace oathbreaker
+{
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::PLD && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_OTB_ACTIVE") == 1;
+}
+
+inline auto isKitAbility(uint16 id) -> bool
+{
+    return id == 46 || id == 48 || id == 255;
+}
+
+inline auto condemnBonus(const CCharEntity* character) -> uint32
+{
+    if (!isActive(character) || character->GetLocalVar("OX_OTB_VOW") != 1)
+    {
+        return 0;
+    }
+    const auto* weapon = dynamic_cast<const CItemWeapon*>(character->m_Weapons[SLOT_MAIN]);
+    return weapon && weapon->getSkillType() == xi::SkillType::GreatSword ? character->GetLocalVar("OX_OTB_BONUS") : 0;
+}
+} // namespace oathbreaker
