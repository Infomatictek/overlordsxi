diff --git a/src/map/utils/archivist_actions.h b/src/map/utils/archivist_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/archivist_actions.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <atomic>
+
+#include "entities/char_entity.h"
+#include "spell.h"
+
+namespace archivist
+{
+inline constexpr uint16 Record = 214;
+inline constexpr uint16 Index = 233;
+inline constexpr uint32 Spell = 1;
+inline constexpr uint32 Technique = 2;
+inline constexpr uint32 Weaponskill = 3;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::SCH && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_ARC_ACTIVE") == 1;
+}
+
+inline auto spellLevel(SpellID id) -> uint8
+{
+    return id == SpellID::Sandstorm || id == SpellID::Stone ? 10 : 0;
+}
+
+inline auto kitAbility(uint16 id, uint8 level) -> bool
+{
+    return id == Record || (id == Index && level >= 50);
+}
+
+inline auto nextSpawn() -> uint32
+{
+    static std::atomic<uint32> next{ 1 };
+    return next.fetch_add(1, std::memory_order_relaxed);
+}
+
+class ActionScope
+{
+public:
+    ActionScope(CBattleEntity& source, uint32 category, uint16 id, bool eligible)
+    : source_(source)
+    , active_(eligible && source_.objtype == TYPE_MOB && source_.allegiance == xi::Allegiance::Mob &&
+              source_.GetLocalVar("OX_ARC_SCRIPTED") == 0)
+    {
+        if (active_)
+        {
+            const auto sequence = std::max(source_.GetLocalVar("OX_ARC_SEQUENCE") + 1, 1u);
+            source_.SetLocalVar("OX_ARC_SEQUENCE", sequence);
+            source_.SetLocalVar("OX_ARC_ACTION", id);
+            source_.SetLocalVar("OX_ARC_CATEGORY", category);
+        }
+    }
+
+    ~ActionScope()
+    {
+        if (active_)
+        {
+            source_.SetLocalVar("OX_ARC_ACTION", 0);
+            source_.SetLocalVar("OX_ARC_CATEGORY", 0);
+        }
+    }
+
+    auto active() const -> bool { return active_; }
+
+private:
+    CBattleEntity& source_;
+    bool active_;
+};
+} // namespace archivist
