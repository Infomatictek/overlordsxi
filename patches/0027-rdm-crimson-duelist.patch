+auto isCrimsonDuelistSpec(CBattleEntity* PEntity) -> bool
+{
+    auto* PChar = dynamic_cast<CCharEntity*>(PEntity);
+    return PChar != nullptr && PChar->GetMJob() == xi::Job::RDM && PChar->GetMLevel() >= 10 && PChar->hasTrait(163);
+}
+
+auto isCrimsonFlowSpell(CSpell* PSpell) -> bool
+{
+    return PSpell != nullptr &&
+           (PSpell->getSkillType() == xi::SkillType::EnfeeblingMagic ||
+            PSpell->getID() == SpellID::Stoneskin ||
+            PSpell->getID() == SpellID::Phalanx);
+}
