diff --git a/src/map/utils/zealot_actions.h b/src/map/utils/zealot_actions.h
new file mode 100644
--- /dev/null
+++ b/src/map/utils/zealot_actions.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "entities/char_entity.h"
+#include "items/item_weapon.h"
+#include "spell.h"
+
+namespace zealot
+{
+struct SpellProfile
+{
+    uint8 level;
+    uint8 mpPercent;
+    uint8 recastSeconds;
+};
+
+inline constexpr uint16 SealAbility = 74;
+
+inline auto isActive(const CCharEntity* character) -> bool
+{
+    return character && character->GetMJob() == xi::Job::WHM && character->GetMLevel() >= 10 &&
+           character->GetLocalVar("OX_ZEALOT_ACTIVE") == 1;
+}
+
+inline auto hasStaff(const CCharEntity* character) -> bool
+{
+    const auto* weapon = dynamic_cast<const CItemWeapon*>(character->m_Weapons[SLOT_MAIN]);
+    return weapon && weapon->getSkillType() == xi::SkillType::Staff;
+}
+
+inline auto spellProfile(SpellID id, uint8 level) -> SpellProfile
+{
+    switch (id)
+    {
+        case SpellID::Banish:     return { 10, 8, 6 };
+        case SpellID::Banish_II:  return { 30, 12, 8 };
+        case SpellID::Banish_III: return { 50, 16, 12 };
+        case SpellID::Holy:       return { 50, static_cast<uint8>(level >= 70 ? 22 : 20), 14 };
+        default:                 return {};
+    }
+}
+} // namespace zealot
