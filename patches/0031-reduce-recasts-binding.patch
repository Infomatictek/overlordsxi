+
+void CRecastContainer::ReduceRecasts(timer::duration reduction)
+{
+    if (reduction <= 0s)
+    {
+        return;
+    }
+
+    for (auto type : { xi::RecastType::Magic, xi::RecastType::Ability })
+    {
+        RecastList_t* PRecastList = GetRecastList(type);
+        if (!PRecastList)
+        {
+            continue;
+        }
+
+        for (auto&& recast : *PRecastList)
+        {
+            if (recast.RecastTime <= 0s)
+            {
+                continue;
+            }
+            if (type == xi::RecastType::Ability && (recast.ID == xi::Recast::Special || recast.ID == xi::Recast::Special2))
+            {
+                continue;
+            }
+
+            if (recast.RecastTime <= reduction)
+            {
+                recast.RecastTime = 0s;
+            }
+            else
+            {
+                recast.RecastTime -= reduction;
+            }
+        }
+    }
+
+    Check();
+}
