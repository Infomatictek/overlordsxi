+void CLuaBaseEntity::reduceRecasts(uint32 seconds)
+{
+    if (seconds == 0)
+    {
+        return;
+    }
+
+    if (auto* PBattleEntity = dynamic_cast<CBattleEntity*>(m_PBaseEntity))
+    {
+        PBattleEntity->PRecastContainer->ReduceRecasts(std::chrono::seconds(seconds));
+        if (PBattleEntity->objtype == TYPE_PC)
+        {
+            auto* PChar = static_cast<CCharEntity*>(m_PBaseEntity);
+            PChar->pushPacket<GP_SERV_COMMAND_CLISTATUS2>(PChar);
+            PChar->pushPacket<GP_SERV_COMMAND_ABIL_RECAST>(PChar);
+        }
+    }
+}
