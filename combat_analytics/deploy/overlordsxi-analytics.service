[Unit]
Description=SoulspireXI Combat Analytics Backend
After=network.target

[Service]
Type=simple
User=overlords
Group=overlords
WorkingDirectory=/opt/overlordsxi
EnvironmentFile=/etc/overlordsxi/combat-analytics.env
ExecStart=/usr/bin/python3 -m combat_analytics.cli serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/overlordsxi-analytics

[Install]
WantedBy=multi-user.target
