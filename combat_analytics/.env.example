# OverlordsXI Combat Analytics Backend Configuration
# Copy to `combat_analytics/.env` (gitignored) and populate secrets before deploying.
# NEVER commit a populated `.env` file or place it inside `site/`.

# Bind address & port (keep 127.0.0.1 when running behind SWAG/Nginx on the same host)
OVERLORDS_ANALYTICS_HOST=127.0.0.1
OVERLORDS_ANALYTICS_PORT=8765

# Persistent SQLite database path (MUST be outside `site/` and gitignored)
OVERLORDS_ANALYTICS_DB=/var/lib/overlordsxi-analytics/analytics.db

# Server-side Soul Proving Grounds telemetry log locations (read-only mount recommended)
OVERLORDS_PG_LOG_DIR=/srv/overlordsxi-server/log/proving_grounds
OVERLORDS_PG_LEGACY_LOG=/srv/overlordsxi-server/log/proving_grounds_runs.jsonl

# Background importer poll interval in seconds (0 disables automatic polling)
OVERLORDS_POLL_INTERVAL_SEC=15

# Retention: keep N most recent unpinned reports per character, plus ALL pinned reports
OVERLORDS_RETENTION_PER_CHARACTER=50

# Public URL of your wiki (used to construct share links, e.g. https://wiki.example.com)
OVERLORDS_PUBLIC_BASE_URL=https://wiki.example.com

# Cookie & Proxy Security (set COOKIE_SECURE=1 behind SWAG HTTPS)
OVERLORDS_COOKIE_SECURE=1
OVERLORDS_TRUST_PROXY_HEADERS=1
OVERLORDS_SESSION_TTL_HOURS=168
OVERLORDS_MAX_LOGIN_ATTEMPTS=10
OVERLORDS_LOGIN_WINDOW_SEC=900

# Local dev only: set to 1 to also serve static `site/` files from this Python process
OVERLORDS_SERVE_STATIC_SITE=0

# Authentication Providers (DO NOT use FFXI game passwords)
OVERLORDS_ENABLE_LOCAL_AUTH=1
OVERLORDS_OAUTH_ALLOW_PLAYERS=1

# Optional: Discord OAuth2 (create app at https://discord.com/developers/applications)
# OVERLORDS_DISCORD_CLIENT_ID=
# OVERLORDS_DISCORD_CLIENT_SECRET=
# OVERLORDS_DISCORD_REDIRECT_URI=https://wiki.example.com/api/combat/auth/oauth/discord/callback
# OVERLORDS_DISCORD_ADMIN_IDS=123456789012345678

# Optional: GitHub OAuth2 (create OAuth App in GitHub Developer Settings)
# OVERLORDS_GITHUB_CLIENT_ID=
# OVERLORDS_GITHUB_CLIENT_SECRET=
# OVERLORDS_GITHUB_REDIRECT_URI=https://wiki.example.com/api/combat/auth/oauth/github/callback
# OVERLORDS_GITHUB_ADMIN_USERS=infomatictek
